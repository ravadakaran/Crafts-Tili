</style>

<script>
(function() {
  function setCartLoading(loading) {
    var overlay = document.getElementById('cart-loading-overlay');
    if (overlay) {
      overlay.style.display = loading ? 'flex' : 'none';
    }
  }

  // 1. Update standalone item quantity
  window.updateItemQty = async function(itemKey, newQty) {
    newQty = parseInt(newQty, 10);
    if (isNaN(newQty) || newQty < 0) newQty = 0;

    setCartLoading(true);
    try {
      var res = await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: itemKey, quantity: newQty })
      });

      if (!res.ok) throw new Error('Quantity update failed');
      window.location.reload();
    } catch (err) {
      console.error('Error updating item quantity:', err);
      alert('Could not update quantity. Please try again.');
      setCartLoading(false);
    }
  };

  // 2. Remove bundle (parent + child charms)
  window.removeBundle = async function(bundleId) {
    if (!bundleId) return;
    setCartLoading(true);
    try {
      var res = await fetch('/cart.js');
      var cart = await res.json();
      var updates = {};

      cart.items.forEach(function(item) {
        if (item.properties && item.properties._bundle_id === bundleId) {
          updates[item.key] = 0;
        }
      });

      await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ updates: updates })
      });

      window.location.reload();
    } catch (err) {
      console.error('Error removing bundle:', err);
      alert('Could not remove custom piece. Please try again.');
      setCartLoading(false);
    }
  };

  // 3. Update quantity of a custom bundle proportionally
  window.updateBundleQty = async function(bundleId, newQty) {
    newQty = parseInt(newQty, 10);
    if (isNaN(newQty) || newQty <= 0) {
      return window.removeBundle(bundleId);
    }

    setCartLoading(true);
    try {
      var res = await fetch('/cart.js');
      var cart = await res.json();

      var parentItem = cart.items.find(function(item) {
        return item.properties && 
               item.properties._bundle_id === bundleId && 
               item.properties._bundle_child !== 'true';
      });

      if (!parentItem) {
        return window.removeBundle(bundleId);
      }

      var currentParentQty = parentItem.quantity || 1;
      var updates = {};

      cart.items.forEach(function(item) {
        if (item.properties && item.properties._bundle_id === bundleId) {
          if (item.properties._bundle_child === 'true') {
            // Scale child count based on current ratio
            var childRatio = Math.round(item.quantity / currentParentQty) || 1;
            updates[item.key] = childRatio * newQty;
          } else {
            updates[item.key] = newQty;
          }
        }
      });

      await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ updates: updates })
      });

      window.location.reload();
    } catch (err) {
      console.error('Error updating bundle quantity:', err);
      alert('Could not update bundle quantity. Please try again.');
      setCartLoading(false);
    }
  };

  // 4. Autosave cart note on input change
  document.addEventListener('DOMContentLoaded', function() {
    var noteInput = document.getElementById('cart-special-note');
    if (noteInput) {
      var noteTimeout;
      noteInput.addEventListener('input', function() {
        clearTimeout(noteTimeout);
        noteTimeout = setTimeout(function() {
          fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ note: noteInput.value })
          }).catch(function(e) { console.warn('Note save error:', e); });
        }, 800);
      });
    }

    // 5. Purge any orphan child charms whose parent strap was deleted
    fetch('/cart.js')
      .then(function(res) { return res.json(); })
      .then(function(cart) {
        if (!cart.items || cart.items.length === 0) return;

        var parentBundleIds = {};
        cart.items.forEach(function(item) {
          if (item.properties && item.properties._bundle_id && item.properties._bundle_child !== 'true') {
            parentBundleIds[item.properties._bundle_id] = true;
          }
        });

        var orphanUpdates = {};
        var hasOrphans = false;

        cart.items.forEach(function(item) {
          if (item.properties && item.properties._bundle_child === 'true') {
            var bId = item.properties._bundle_id;
            if (!bId || !parentBundleIds[bId]) {
              orphanUpdates[item.key] = 0;
              hasOrphans = true;
            }
          }
        });

        if (hasOrphans) {
          return fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ updates: orphanUpdates })
          }).then(function() { window.location.reload(); });
        }
      })
      .catch(function(err) {
        console.warn('Orphan check error:', err);
      });
  });
})();
</script>