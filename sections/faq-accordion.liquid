<section class="titli-faq-section" id="faq">
  <div class="faq-container">
    
    <div class="faq-header">
      <span class="faq-eyebrow">FREQUENTLY ASKED QUESTIONS</span>
      <h2 class="faq-title">Curious About Our Charms?</h2>
      <p class="faq-subtext">Everything you need to know about atelier craftsmanship, compatibility, and bespoke orders.</p>
    </div>

    <div class="faq-accordion-list">
      
      <!-- FAQ Item 1 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-question-text">Will the charm fit my phone case?</span>
          <span class="faq-chevron-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
        <div class="faq-answer-pane">
          <div class="faq-answer-inner">
            <p><strong>Yes, universally compatible!</strong> Our charms feature a flexible, high-tensile loop designed to thread effortlessly through any opening on your phone case—such as the bottom speaker cutout, mute switch opening, or camera bezel. No sticky adhesives or special accessories required.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Item 2 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-question-text">How durable is the cord? Will it snap under daily use?</span>
          <span class="faq-chevron-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
        <div class="faq-answer-pane">
          <div class="faq-answer-inner">
            <p>We hand-string every charm using double-reinforced braided cords and premium crimp hardware tested for daily carrying, bag friction, and wrist use. While phone charms are decorative jewelry for your device, ours are crafted to last without fraying or sudden breakage.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Item 3 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-question-text">How do I order a custom charm with my name or initials?</span>
          <span class="faq-chevron-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
        <div class="faq-answer-pane">
          <div class="faq-answer-inner">
            <p>Simply navigate to our interactive <a href="/pages/design-custom-piece" style="color: #712423; font-weight: 700; text-decoration: underline;">Customizer Studio</a>. You can pick your base (phone strap or bag clasp), input up to 7 letters for your name or initials, select your preferred theme palette, and choose charms before checking out!</p>
          </div>
        </div>
      </div>

      <!-- FAQ Item 4 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-question-text">What are your dispatch and delivery timelines across India?</span>
          <span class="faq-chevron-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
        <div class="faq-answer-pane">
          <div class="faq-answer-inner">
            <p>Catalog items dispatch within 24–48 hours. Because personalized custom pieces are hand-strung one by one, please allow 2–3 business days for creation. Once dispatched, standard shipping takes 4–7 business days with live SMS and WhatsApp tracking updates.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Item 5 -->
      <div class="faq-item">
        <button type="button" class="faq-question-btn" aria-expanded="false">
          <span class="faq-question-text">Can I place a bulk order for birthdays, return gifts, or bridesmaids?</span>
          <span class="faq-chevron-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
        <div class="faq-answer-pane">
          <div class="faq-answer-inner">
            <p>Yes, we adore creating custom favor bundles! We provide special party packaging, customized greeting cards, and bulk pricing for orders of 10+ charms. Reach out to our studio at <a href="mailto:support@craftstitli.co.in" style="color: #712423; font-weight: 700;">support@craftstitli.co.in</a> or message us on Instagram.</p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
.titli-faq-section {
  padding: 70px 20px;
  background: transparent;
}

.faq-container {
  max-width: 820px;
  margin: 0 auto;
}

.faq-header {
  text-align: center;
  margin-bottom: 40px;
}

.faq-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #607353;
  margin-bottom: 8px;
}

.faq-title {
  margin: 0 0 10px 0;
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-size: 32px;
  font-weight: 700;
  color: #712423;
  letter-spacing: -0.5px;
}

.faq-subtext {
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 14.5px;
  color: #554D48;
  margin: 0;
}

.faq-accordion-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.faq-item {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(231, 219, 202, 0.85);
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  box-shadow: 0 2px 10px rgba(113, 36, 35, 0.03);
}

.faq-item:hover {
  border-color: #B7684C;
  background: #ffffff;
}

.faq-item.is-open {
  background: #ffffff;
  border-color: #712423;
  box-shadow: 0 8px 24px rgba(113, 36, 35, 0.08);
}

.faq-question-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 22px;
  background: none;
  border: none;
  text-align: left;
  cursor: pointer;
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-size: 16px;
  font-weight: 700;
  color: #712423;
  transition: color 0.2s ease;
}

.faq-chevron-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #FAF5EE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #712423;
  transition: transform 0.3s ease, background 0.3s ease;
}

.faq-item.is-open .faq-chevron-icon {
  transform: rotate(180deg);
  background: #712423;
  color: #FAF5EE;
}

.faq-answer-pane {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-answer-inner {
  padding: 0 22px 20px 22px;
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 14px;
  line-height: 1.65;
  color: #4A443E;
  border-top: 1px dashed rgba(231, 219, 202, 0.6);
  margin-top: -2px;
  padding-top: 14px;
}

.faq-answer-inner p {
  margin: 0;
}

@media (max-width: 600px) {
  .titli-faq-section {
    padding: 40px 16px;
  }
  .faq-title {
    font-size: 24px;
  }
  .faq-question-btn {
    font-size: 14.5px;
    padding: 16px 18px;
  }
  .faq-answer-inner {
    padding: 0 18px 16px 18px;
    font-size: 13px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const faqItems = document.querySelectorAll('.titli-faq-section .faq-item');
  
  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-question-btn');
    const pane = item.querySelector('.faq-answer-pane');
    
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('is-open');
      
      // Close all items
      faqItems.forEach(otherItem => {
        otherItem.classList.remove('is-open');
        otherItem.querySelector('.faq-question-btn').setAttribute('aria-expanded', 'false');
        otherItem.querySelector('.faq-answer-pane').style.maxHeight = null;
      });
      
      // Toggle selected item
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        pane.style.maxHeight = pane.scrollHeight + 'px';
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}
