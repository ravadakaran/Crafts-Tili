<div class="image-slider-wrapper" data-slider id="Slider-{{ section.id }}">
  <div class="slider-track" data-track>
    {% for block in section.blocks %}
      <div class="slider-slide" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
        {% endif %}
        
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
        
        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="slider-controls" style="background-color: transparent;">
    <div class="slider-dots" data-dots>
      {% for block in section.blocks %}
        <button type="button" class="dot {% if forloop.first %}active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  </div>
</div>

<style>
.image-slider-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.slider-track {
  display: flex;
  transition: transform 0.5s ease-in-out;
  width: 100%;
}

.slider-slide {
  min-width: 100%;
  flex: 0 0 100%;
}

.slider-slide img, .slider-slide svg {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.slider-slide .placeholder-svg {
  background-color: #f3f3f3;
  max-height: 400px;
}

.slider-controls {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  box-sizing: border-box;
}


.slider-dots {
  display: flex;
  gap: 12px;
  align-items: center;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1.5px solid #fff;
  background: transparent;
  padding: 0;
  cursor: pointer;
  transition: all 0.3s;
  box-shadow: 0px 1px 3px rgba(0,0,0,0.3);
}

.dot.active {
  background-color: #fff;
  transform: scale(1.2);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const wrapper = document.querySelector('#Slider-{{ section.id }}');
  if (!wrapper) return;
  
  const track = wrapper.querySelector('[data-track]');
  const slides = wrapper.querySelectorAll('[data-slide]');
  const dots = wrapper.querySelectorAll('[data-dot-index]');
  
  if (slides.length <= 1) {
    if(wrapper.querySelector('.slider-controls')) {
      wrapper.querySelector('.slider-controls').style.display = 'none';
    }
    return;
  }

  let currentIndex = 0;
  let isPlaying = true;
  let slideInterval;
  const intervalTime = 5000;

  function goToSlide(index) {
    if (index < 0) index = slides.length - 1;
    if (index >= slides.length) index = 0;
    
    currentIndex = index;
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    
    dots.forEach(dot => dot.classList.remove('active'));
    dots[currentIndex].classList.add('active');
  }

  function nextSlide() {
    goToSlide(currentIndex + 1);
  }

  function prevSlide() {
    goToSlide(currentIndex - 1);
  }

  function startAutoplay() {
    if (isPlaying) {
      slideInterval = setInterval(nextSlide, intervalTime);
    }
  }

  function stopAutoplay() {
    clearInterval(slideInterval);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', (e) => {
      const index = parseInt(e.target.getAttribute('data-dot-index'));
      goToSlide(index);
      stopAutoplay();
      if (isPlaying) startAutoplay();
    });
  });

  startAutoplay();
});
</script>

{% schema %}
{
  "name": "Image Slider",
  "settings": [
    {
      "type": "color",
      "id": "controls_bg",
      "label": "Controls Background",
      "default": "#f4f4f4"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
