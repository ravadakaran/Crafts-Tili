<section class="titli-customizer-teaser-section" id="customizer-teaser">
  <!-- Subtle Ambient Glows -->
  <div class="teaser-ambient-glow glow-1" aria-hidden="true"></div>
  <div class="teaser-ambient-glow glow-2" aria-hidden="true"></div>

  <div class="teaser-container">
    <div class="teaser-layout-grid">
      
      <!-- Left Column: Interactive Visual Showcase Card -->
      <div class="teaser-interactive-col">
        <div class="teaser-preview-card" id="teaserInteractiveCard">
          
          <div class="card-glass-header">
            <span class="card-live-tag">● LIVE ATELIER MOCKUP</span>
            <span class="card-edition-tag">Atelier No. 01</span>
          </div>

          <!-- Visual Charm Mockup Stage -->
          <div class="mockup-canvas-stage">
            
            <!-- Tether Loop -->
            <div class="mockup-strap-loop" id="mockupStrapLoop">
              <svg viewBox="0 0 50 140" fill="none" class="mockup-loop-svg">
                <path d="M25 2 C 38 2, 45 18, 45 42 C 45 64, 32 78, 25 85 C 18 78, 5 64, 5 42 C 5 18, 12 2, 25 2 Z" stroke="#241D26" stroke-width="3" fill="none" stroke-linecap="round"/>
                <path d="M25 85 V 135" stroke="#241D26" stroke-width="3.5" stroke-linecap="round"/>
              </svg>
            </div>

            <!-- Floating Beads Stack (Spells TITLI) -->
            <div class="mockup-beads-stack" id="mockupBeadsStack">
              <span class="mockup-bead bead-t">T</span>
              <span class="mockup-bead bead-i">I</span>
              <span class="mockup-bead bead-t2">T</span>
              <span class="mockup-bead bead-l">L</span>
              <span class="mockup-bead bead-i2">I</span>
            </div>

            <!-- Dangle Charms Cluster -->
            <div class="mockup-charms-cluster" id="mockupCharmsCluster">
              <div class="mockup-charm-dangle charm-butterfly" title="Crystal Butterfly">
                <span class="charm-icon">🦋</span>
                <span class="charm-sparkle-dot"></span>
              </div>
              <div class="mockup-charm-dangle charm-prism" title="Aurora Prism">
                <span class="charm-icon">💎</span>
                <span class="charm-sparkle-dot"></span>
              </div>
              <div class="mockup-charm-dangle charm-star" title="Starlight Pearl">
                <span class="charm-icon">⭐</span>
                <span class="charm-sparkle-dot"></span>
              </div>
              <div class="mockup-charm-dangle charm-flower" title="Pastel Blossom">
                <span class="charm-icon">🌸</span>
                <span class="charm-sparkle-dot"></span>
              </div>
            </div>

            <!-- Subtle Floating Ambient Particles -->
            <span class="ambient-particle part-1">✨</span>
            <span class="ambient-particle part-2">💫</span>
          </div>

          <!-- Interactive Style Selector -->
          <div class="card-palette-selector">
            <span class="selector-title">Preview Palette Theme:</span>
            <div class="palette-swatch-row">
              <button type="button" class="teaser-swatch-btn active" data-theme="pastel" data-bead-bg="#FFF6FA" data-bead-color="#712423" data-strap="#241D26">
                <span class="swatch-color-dot" style="background: linear-gradient(135deg, #FAD0C4, #FFD1FF);"></span>
                <span>Pastel Dream</span>
              </button>
              <button type="button" class="teaser-swatch-btn" data-theme="celestial" data-bead-bg="#EBF4FF" data-bead-color="#1E3A8A" data-strap="#1E293B">
                <span class="swatch-color-dot" style="background: linear-gradient(135deg, #A1C4FD, #C2E9FB);"></span>
                <span>Celestial Sky</span>
              </button>
              <button type="button" class="teaser-swatch-btn" data-theme="forest" data-bead-bg="#F4F8F3" data-bead-color="#2D5A27" data-strap="#3D3A37">
                <span class="swatch-color-dot" style="background: linear-gradient(135deg, #D4FC79, #96E6A1);"></span>
                <span>Forest Sage</span>
              </button>
            </div>
          </div>

          <!-- Direct Link inside Card -->
          <div class="card-footer-action">
            <a href="/pages/design-custom-piece" class="card-start-btn">
              <span>Start Designing In Studio</span>
              <span>→</span>
            </a>
          </div>

        </div>
      </div>

      <!-- Right Column: Editorial & Storytelling -->
      <div class="teaser-content-col">
        <div class="teaser-eyebrow-pill">
          <span class="teaser-sparkle">✨</span>
          <span>INTERACTIVE ATELIER EXPERIENCE</span>
        </div>

        <h2 class="teaser-headline">
          Build Your Own <span class="teaser-headline-italic">Signature Charm</span>
        </h2>

        <p class="teaser-description">
          Make it uniquely yours. Our interactive 3D builder lets you choose your durable strap, spell your name with high-polish alphabet beads, and adorn with hand-selected crystals, pearls, and celestial charms.
        </p>

        <!-- 3-Step Process Cards -->
        <div class="teaser-steps-list">
          <div class="teaser-step-item">
            <div class="step-num-badge">01</div>
            <div class="step-text">
              <strong>Pick Your Canvas</strong>
              <span>Choose between woven phone strap cords or heavy-duty bag clasps.</span>
            </div>
          </div>

          <div class="teaser-step-item">
            <div class="step-num-badge">02</div>
            <div class="step-text">
              <strong>Spell Your Story</strong>
              <span>Personalize with custom letter beads for your name, initials, or lucky word.</span>
            </div>
          </div>

          <div class="teaser-step-item">
            <div class="step-num-badge">03</div>
            <div class="step-text">
              <strong>Adorn With Charms</strong>
              <span>Select butterfly crystals, evil eyes, kawaii stars, and floral pendants.</span>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="teaser-action-row">
          <a href="/pages/design-custom-piece" class="teaser-primary-btn">
            <span class="btn-text">Open Customizer Studio</span>
            <span class="btn-arrow">✨ →</span>
          </a>
          <div class="teaser-price-hint">
            <span class="price-hint-label">Starting at only</span>
            <span class="price-hint-value">₹149</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.titli-customizer-teaser-section {
  padding: 80px 20px;
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle at 10% 20%, #FFF5F5 0%, #FFF5F5 100%);
}

.teaser-ambient-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: 1;
}

.glow-1 {
  width: 450px;
  height: 450px;
  background: rgba(179, 32, 37, 0.08);
  top: -100px;
  right: -50px;
}

.glow-2 {
  width: 400px;
  height: 400px;
  background: rgba(96, 115, 83, 0.08);
  bottom: -80px;
  left: -50px;
}

.teaser-container {
  max-width: 1240px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.teaser-layout-grid {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 48px;
  align-items: center;
}

/* Left Content */
.teaser-eyebrow-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(113, 36, 35, 0.08);
  border: 1px solid rgba(113, 36, 35, 0.2);
  color: #712423;
  padding: 6px 14px;
  border-radius: 30px;
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 1px;
  margin-bottom: 18px;
}

.teaser-headline {
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-size: 38px;
  line-height: 1.22;
  font-weight: 700;
  color: #712423;
  margin: 0 0 16px 0;
  letter-spacing: -0.5px;
}

.teaser-headline-italic {
  font-style: italic;
  font-weight: 400;
  background: linear-gradient(135deg, #712423 0%, #B7684C 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.teaser-description {
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 15.5px;
  line-height: 1.65;
  color: #4A443E;
  margin: 0 0 32px 0;
  max-width: 580px;
}

.teaser-steps-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 36px;
}

.teaser-step-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(231, 219, 202, 0.8);
  border-radius: 14px;
  padding: 14px 18px;
  transition: all 0.25s ease;
}

.teaser-step-item:hover {
  background: #ffffff;
  border-color: #B7684C;
  transform: translateX(4px);
}

.step-num-badge {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: #FAF5EE;
  border: 1px solid #ECE5DC;
  color: #712423;
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-weight: 700;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.step-text strong {
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-size: 14.5px;
  font-weight: 700;
  color: #712423;
}

.step-text span {
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 13px;
  color: #615B55;
  line-height: 1.4;
}

.teaser-action-row {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: wrap;
}

.teaser-primary-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #712423 0%, #8D302F 100%);
  color: #FAF5EE;
  text-decoration: none;
  padding: 16px 32px;
  border-radius: 40px;
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.3px;
  box-shadow: 0 8px 24px rgba(113, 36, 35, 0.25);
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.teaser-primary-btn:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 12px 30px rgba(113, 36, 35, 0.35);
  background: linear-gradient(135deg, #8D302F 0%, #B7684C 100%);
  color: #ffffff;
}

.teaser-price-hint {
  display: flex;
  flex-direction: column;
}

.price-hint-label {
  font-size: 11.5px;
  color: #7A726A;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 600;
}

.price-hint-value {
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-size: 20px;
  font-weight: 700;
  color: #712423;
}

/* Right Interactive Preview Card */
.teaser-preview-card {
  background: #ffffff;
  border-radius: 28px;
  border: 1px solid #ECE5DC;
  padding: 26px;
  box-shadow: 0 16px 40px rgba(113, 36, 35, 0.08), 0 2px 6px rgba(0,0,0,0.02);
  position: relative;
  display: flex;
  flex-direction: column;
}

.card-glass-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16px;
  border-bottom: 1px solid #F0ECE6;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
}

.card-live-tag {
  color: #607353;
  display: flex;
  align-items: center;
  gap: 4px;
}

.card-edition-tag {
  color: #9C9389;
}

/* Mockup Canvas Stage */
.mockup-canvas-stage {
  height: 290px;
  margin: 16px 0;
  background: radial-gradient(circle, #FAF7F2 0%, #F5EFE6 100%);
  border-radius: 20px;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 18px;
  overflow: hidden;
  border: 1px solid #EFEAE2;
}

.mockup-strap-loop {
  width: 40px;
  height: 80px;
  animation: strap-float 3.5s ease-in-out infinite alternate;
}

.mockup-loop-svg {
  width: 100%;
  height: 100%;
}

.mockup-beads-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  margin-top: -6px;
  z-index: 2;
  animation: strap-float 3.5s ease-in-out infinite alternate;
}

.mockup-bead {
  width: 26px;
  height: 24px;
  border-radius: 8px;
  background: #FFF6FA;
  border: 1.5px solid #F2DCE5;
  color: #712423;
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-size: 13px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 6px rgba(0,0,0,0.06), inset 0 1px 2px rgba(255,255,255,0.8);
  transition: all 0.3s ease;
}

.mockup-charms-cluster {
  display: flex;
  gap: 12px;
  margin-top: 6px;
  z-index: 2;
  animation: charm-sway 2.8s ease-in-out infinite alternate;
}

.mockup-charm-dangle {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #ffffff;
  border: 1px solid #EEDCE2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(113, 36, 35, 0.12);
  position: relative;
  transition: transform 0.3s ease;
}

.mockup-charm-dangle:hover {
  transform: scale(1.2) rotate(8deg);
}

.charm-icon {
  font-size: 16px;
}

.ambient-particle {
  position: absolute;
  font-size: 14px;
  animation: particle-pulse 2s ease-in-out infinite alternate;
  pointer-events: none;
}

.part-1 { top: 25px; left: 30px; animation-delay: 0.2s; }
.part-2 { bottom: 35px; right: 35px; animation-delay: 0.8s; }

@keyframes strap-float {
  0% { transform: translateY(0px) rotate(-1deg); }
  100% { transform: translateY(8px) rotate(1.5deg); }
}

@keyframes charm-sway {
  0% { transform: rotate(-3deg); }
  100% { transform: rotate(4deg); }
}

@keyframes particle-pulse {
  0% { opacity: 0.3; transform: scale(0.9); }
  100% { opacity: 0.9; transform: scale(1.2); }
}

/* Palette Swatches */
.card-palette-selector {
  padding-top: 14px;
  border-top: 1px solid #F0ECE6;
}

.selector-title {
  display: block;
  font-size: 11.5px;
  font-weight: 700;
  color: #7A726A;
  margin-bottom: 8px;
}

.palette-swatch-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.teaser-swatch-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #FAF7F2;
  border: 1.5px solid #EAE3D9;
  border-radius: 20px;
  padding: 6px 12px;
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 12px;
  font-weight: 600;
  color: #4A443E;
  cursor: pointer;
  transition: all 0.2s ease;
}

.teaser-swatch-btn.active, .teaser-swatch-btn:hover {
  background: #ffffff;
  border-color: #712423;
  color: #712423;
  box-shadow: 0 2px 8px rgba(113, 36, 35, 0.1);
}

.swatch-color-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  display: inline-block;
}

.card-footer-action {
  margin-top: 16px;
}

.card-start-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  background: #FAF5EE;
  border: 1px dashed #B7684C;
  color: #712423;
  text-decoration: none;
  padding: 12px 18px;
  border-radius: 12px;
  font-size: 13.5px;
  font-weight: 700;
  transition: all 0.25s ease;
}

.card-start-btn:hover {
  background: #712423;
  color: #FAF5EE;
  border-color: #712423;
}

@media (max-width: 900px) {
  .titli-customizer-teaser-section {
    padding: 40px 14px;
  }
  .teaser-layout-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  .teaser-headline {
    font-size: 26px;
  }
  .teaser-description {
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 20px;
  }
  .teaser-steps-list {
    gap: 10px;
    margin-bottom: 22px;
  }
  .teaser-step-item {
    padding: 10px 14px;
    gap: 12px;
  }
  .step-text strong {
    font-size: 13.5px;
  }
  .step-text span {
    font-size: 12px;
  }
  .teaser-action-row {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }
  .teaser-primary-btn {
    width: 100%;
    justify-content: center;
    padding: 14px 20px;
    box-sizing: border-box;
    font-size: 14px;
  }
  .teaser-price-hint {
    align-items: center;
    text-align: center;
  }
  .teaser-preview-card {
    padding: 18px 14px;
    border-radius: 20px;
  }
  .mockup-canvas-stage {
    height: 230px;
  }
  .palette-swatch-row {
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    gap: 6px;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .palette-swatch-row::-webkit-scrollbar {
    display: none;
  }
  .teaser-swatch-btn {
    white-space: nowrap;
    flex-shrink: 0;
    padding: 5px 10px;
    font-size: 11.5px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const swatchBtns = document.querySelectorAll('.teaser-swatch-btn');
  const beads = document.querySelectorAll('.mockup-bead');
  
  swatchBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      swatchBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const beadBg = btn.dataset.beadBg;
      const beadColor = btn.dataset.beadColor;
      
      beads.forEach(bead => {
        bead.style.backgroundColor = beadBg;
        bead.style.color = beadColor;
      });
    });
  });
});
</script>

