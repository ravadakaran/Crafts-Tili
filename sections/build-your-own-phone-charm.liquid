    background: repeating-linear-gradient(180deg, currentColor 0 7px, color-mix(in srgb, currentColor 72%, white) 7px 11px);
    box-shadow: inset -1px 0 1px rgba(0,0,0,0.22), 0 2px 5px rgba(0,0,0,0.12);
