  /* Controls */
  .customizer-controls-card { background: #FFFFFF; border: 1.5px solid #EFE4D6; border-radius: 20px; padding: 24px; box-shadow: 0 8px 30px rgba(0,0,0,0.02); width: 100%; box-sizing: border-box;}
