      nextFromPaletteBtn.addEventListener('click', function(e) {
        e.preventDefault();
        switchTab('tab-charms');
      });
    }

    var backFromCharmsBtn = document.getElementById('stepperBackFromCharms');
    if (backFromCharmsBtn) {
      backFromCharmsBtn.addEventListener('click', function(e) {
        e.preventDefault();
        switchTab('tab-palette');
      });
    }

    var stepperDirectAddBtn = document.getElementById('stepperDirectAddBtn');
    if (stepperDirectAddBtn) {
      stepperDirectAddBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (state.modelType === 'bag-clip-multi') {
          if (addMultiToBagBtn) addMultiToBagBtn.click();
        } else if (state.modelType === 'bag-clip-single') {
          if (singleDirectAddBtn) singleDirectAddBtn.click();
        } else {
          if (phoneDirectAddBtn) phoneDirectAddBtn.click();
        }
      });
    }

    // 3. Clasp Swatches
    function applySelectedClasp(card) {
      if (!card) return;
      state.claspColor = card.getAttribute('data-clasp-color');
      state.claspName = card.getAttribute('data-clasp-name');
      state.claspPrice = parseInt(card.getAttribute('data-clasp-price') || '0', 10);
      
      if (renderClasp) renderClasp.style.color = state.claspColor;
      var strandsCluster = document.getElementById('strandsCluster');
      if (strandsCluster) {
        strandsCluster.style.color = state.claspColor;
        strandsCluster.style.setProperty('--strand-clasp-color', state.claspColor);
      }
      if (renderClaspSingle) renderClaspSingle.style.color = state.claspColor;
      if (singleCordStrand) singleCordStrand.style.color = state.claspColor;
      if (phoneTether) phoneTether.querySelectorAll('path').forEach(function(p) { p.setAttribute('stroke', state.claspColor); });
      
      renderBagClipMultiStrands();
      renderSingleCordCharms();
      updatePrices();
