    function syncCharmsGridActiveState() {
      var allCards = document.querySelectorAll('#uploadedCharmsGrid .charm-product-card');
      allCards.forEach(function(card) {
        var cId = card.getAttribute('data-charm-id');
        if (state.modelType === 'bag-clip-multi') {
          var isAssignedAnywhere = [1, 2, 3, 4].some(function(s) {
            return state.bagClipCharms[s] && String(state.bagClipCharms[s].id) === String(cId);
          });
          if (isAssignedAnywhere) card.classList.add('active');
          else card.classList.remove('active');
        } else if (state.modelType === 'bag-clip-single') {
          if (state.bagClipSingleCharms.some(function(c) { return String(c.id) === String(cId); })) card.classList.add('active');
          else card.classList.remove('active');
        } else {
          if (state.phoneCharms.some(function(c) { return String(c.id) === String(cId); })) card.classList.add('active');
          else card.classList.remove('active');
        }
      });

      for (var s = 1; s <= 4; s++) {
        var labelEl = document.getElementById('assignedText' + s);
        if (labelEl) {
          var assigned = state.bagClipCharms[s];
          if (assigned) {
            labelEl.textContent = '✓ ' + assigned.title;
            labelEl.style.color = '#B32025';
          } else {
            var defaults = { 1: 'Default: Bell', 2: 'Default: Heart', 3: 'Default: Flower', 4: 'Default: Key' };
            labelEl.textContent = defaults[s];
            labelEl.style.color = '#9B6B28';
          }
        }
      }

      var multiAttachedCount = [1, 2, 3, 4].filter(function(s) { return state.bagClipCharms[s] !== null; }).length;
      if (multiCharmsCounter) {
        multiCharmsCounter.innerHTML = 'Charms Attached: <strong>' + multiAttachedCount + '/4</strong>';
      }
      updateArrangementHints();
    }

