  .unified-preview-box { width: 100%; background: #FAF6F0; border: 1.5px dashed #E2D5C3; border-radius: 14px; padding: 12px 10px 10px; box-sizing: border-box; text-align: center; position: relative; overflow: hidden; }
  .phone-palette-tag { font-size: 10px; font-weight: 800; color: #9B6B28; letter-spacing: 0.8px; text-transform: uppercase; display: block; margin-bottom: 6px; }
  
  .phone-graphic-container { position: relative; min-height: 175px; height: 175px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 6px; }
  .phone-tether-svg-wrap { width: 36px; height: 160px; color: #241A18; }
