    function sendToCart(baseVariantId, properties, selectedCharms, btn) {
      function resetAddBtns() {
        if (btn) { btn.disabled = false; btn.textContent = '✨ Add Custom Design To Bag'; }
        if (mobileAddBtn) { mobileAddBtn.disabled = false; mobileAddBtn.innerHTML = '<span>✨ Add Custom Design To Bag</span>'; }
      }

      if (btn) { btn.disabled = true; btn.textContent = 'Adding to Bag...'; }
      if (mobileAddBtn) { mobileAddBtn.disabled = true; mobileAddBtn.innerHTML = '<span>Adding to Bag...</span>'; }
      var targetId = parseInt(baseVariantId, 10);
      
      if (!targetId || isNaN(targetId)) {
        alert('Invalid Product Variant ID configuration.');
        resetAddBtns();
        return;
      }

      var bundleId = 'bundle_' + Date.now();
      properties['_bundle_id'] = bundleId;

      var cartItems = [{ id: targetId, quantity: 1, properties: properties }];

      if (selectedCharms && selectedCharms.length > 0) {
        selectedCharms.forEach(function(charm) {
          var charmId = parseInt(charm.id, 10);
          if (charmId && !isNaN(charmId) && charm.price > 0) {
            cartItems.push({ 
              id: charmId, 
              quantity: 1, 
              properties: { 
                '_bundle_id': bundleId,
                '_bundle_child': 'true',
                'Customizer Add-on': 'Included in ' + properties['Creation Type'] 
              } 
            });
          }
        });
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: cartItems })
      })
      .then(function(res) {
        if (!res.ok) return res.json().then(function(err) { throw new Error(err.description || 'Cart add failed'); });
        resetAddBtns();
        if (window.TitliDrawer && typeof window.TitliDrawer.open === 'function') {
          window.TitliDrawer.open();
        } else {
          window.location.href = '/cart';
        }
      })
      .catch(function(err) {
        console.error('Cart Error:', err);
        resetAddBtns();
        alert('Could not add item to cart. Please check your variant configuration.');
      });
    }

