  .charm-arrangement-hint { display: none; width: fit-content; max-width: calc(100% - 16px); margin: 6px auto 0; padding: 4px 8px; border: 1px solid #E8DECE; border-radius: 999px; background: rgba(255,255,255,0.72); color: #7A6B67; font-size: 10px; font-weight: 650; line-height: 1.25; text-align: center; box-sizing: border-box; }
  .charm-arrangement-hint.is-visible { display: flex; align-items: center; justify-content: center; }
