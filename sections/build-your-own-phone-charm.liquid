{% assign charms_col = collections['customizer-charms'] | default: collections['charms'] %}

<!-- NOTE: UPDATE YOUR VARIANT IDS BELOW -->
<div class="titli-customizer-section" id="titliCustomizerApp" 
     data-phone-variant="50663420952773" 
     data-bag-variant="50663426982085"
     data-bag-single-variant="50666935517381">

  <!-- Floating Mini-Preview Pill (Mobile Picture-in-Picture) -->
  <div id="mobileFloatingPreviewPill" class="mobile-floating-preview-pill" role="button" aria-label="Jump to Live Strap Preview">
    <div class="pip-icon-box">
      <span class="pip-icon">✨</span>
      <span class="pip-pulse-dot"></span>
    </div>
    <div class="pip-content">
      <span class="pip-title" id="pipCharmCount">0 Charms</span>
      <div class="pip-charms-row" id="pipCharmsThumbs">
        <span class="pip-empty-hint">Tap to preview strap 🔍</span>
      </div>
    </div>
    <div class="pip-arrow">↑ View</div>
  </div>

  <!-- Instant Toast Notification -->
  <div id="customizerToast" class="customizer-toast-notice" aria-live="polite">
    <span class="toast-icon">✨</span>
    <span class="toast-message" id="toastMessageText">Charm Attached!</span>
  </div>

  <!-- High-Res Charm Zoom Inspection Modal -->
  <div id="charmZoomModal" class="charm-zoom-modal-backdrop" aria-hidden="true">
    <div class="charm-zoom-card">
      <button type="button" class="zoom-close-btn" id="closeZoomModalBtn">✕</button>
      <div class="zoom-media-box" id="zoomMediaContainer"></div>
      <div class="zoom-info-box">
        <h4 class="zoom-title" id="zoomCharmTitle">Charm Name</h4>
        <div class="zoom-meta-row">
          <span class="zoom-price" id="zoomCharmPrice">+₹25.00</span>
          <span class="zoom-badge">Atelier Edition</span>
        </div>
        <p class="zoom-desc" id="zoomCharmDesc">Handcrafted enamel with radiant crystals and tarnish-resistant hardware.</p>
        <button type="button" class="zoom-action-btn" id="zoomAttachActionBtn">
          <span>Attach Charm to Design</span>
        </button>
      </div>
    </div>
  </div>
     
  <div class="customizer-container">
    
    <!-- Left Column: Unified Stage Cards -->
    <div class="customizer-stage-card" id="stageMainCard">
      
      <!-- ==========================================
           VIEW 1: Phone Strap Charm
           ========================================== -->
      <div id="stagePhoneCharmWrapper" style="width: 100%;">
        <div class="stage-header">
          <span class="stage-pill">LIVE PREVIEW</span>
          <h2 class="stage-title">Phone Strap</h2>
        </div>

        <div class="unified-preview-box">
          <span class="phone-palette-tag" id="phonePaletteLabel">PASTEL DREAM PALETTE</span>

          <div class="phone-graphic-container">
            <div class="phone-tether-svg-wrap" id="renderPhoneTether">
              <svg viewBox="0 0 40 190" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 2 C 28 2, 34 14, 34 32 C 34 48, 24 55, 20 60 C 16 55, 6 48, 6 32 C 6 14, 12 2, 20 2 Z" stroke="#241A18" stroke-width="2.5" fill="none"/>
                <path d="M20 60 V185" stroke="#241A18" stroke-width="3" stroke-linecap="round"/>
              </svg>
            </div>

            <div class="phone-name-beads-stack" id="phoneNameBeadsColumn"></div>
            <div class="phone-floating-tooltip" id="phoneTapHint"><span>Tap charms to attach them!</span></div>
            <div class="phone-attached-items" id="phoneAttachedList" role="listbox" aria-label="Phone strap charm arrangement"></div>
            <p class="charm-arrangement-hint" id="phoneArrangementHint">↔ Drag to reorder · Arrow keys supported</p>
          </div>

          <div class="phone-attached-counter-bar">
            <span class="counter-text" id="phoneCharmsCounterText">Charms Attached: <strong>0/4</strong></span>
            <button type="button" class="reset-link-btn" id="phoneResetCharmsBtn">Reset All</button>
          </div>
        </div>

        <div class="desktop-only-action-bar">
          <div class="phone-price-breakdown">
            <div class="price-row"><span>Base Design Price:</span><strong id="phoneBasePriceText">₹50.00</strong></div>
            <div class="price-row"><span>Add-ons Total:</span><strong id="phoneAddonsText">₹0.00</strong></div>
            <div class="price-divider"></div>
            <div class="price-row total-row"><span class="total-label">Estimated Total:</span><span class="total-amount" id="phoneEstimatedTotal">₹50.00</span></div>
          </div>
          <button type="button" class="phone-add-to-bag-btn" id="phoneDirectAddBtn"><span>✨ Add Custom Design To Bag</span></button>
        </div>
      </div>

      <!-- ==========================================
           VIEW 2: Multi-Strand Bag Clip
           ========================================== -->
      <div id="stageBagClipMultiWrapper" style="display: none; width: 100%;">
        <div class="stage-header">
          <span class="stage-pill">LIVE ATELIER PREVIEW</span>
          <h2 class="stage-title">Multi-Strand Bag Clip</h2>
        </div>

        <div class="unified-preview-box">
          <span class="phone-palette-tag" id="multiPaletteLabel">PASTEL DREAM PALETTE</span>
          <div class="keychain-assembly" id="multiBagClipAssembly">
            <div class="keychain-clasp-wrap" id="renderClasp">
              <svg class="clasp-svg" viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="40" r="28" stroke="currentColor" stroke-width="7" fill="none"/>
                <path d="M50 68 V92 M36 92 H64" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
                <circle cx="50" cy="104" r="8" stroke="currentColor" stroke-width="4" fill="none"/>
              </svg>
            </div>

            <div class="strands-fan-cluster" id="strandsCluster" role="listbox" aria-label="Multi-strand charm arrangement">
              <!-- Strand 1: Outer-Left Dotted Cord & Bell Charm -->
              <div class="strand-branch strand-1-accent" id="renderStrand1" title="Strand 1: Dotted Accent (Tap to customize)">
                <div class="dotted-strand-graphic"></div>
                <div class="strand-drop-frame" id="renderDrop1"><span class="drop-placeholder-icon">🔔</span></div>
              </div>

              <!-- Strand 2: Center-Left Name Strand & Heart Charm -->
              <div class="strand-branch strand-2-name" id="renderStrand2" title="Strand 2: Personalized Name (Tap to customize)">
                <div class="strand-beads-vertical" id="renderNameBeads"></div>
                <div class="strand-drop-frame" id="renderDrop2"><span class="drop-placeholder-icon">💚</span></div>
              </div>

              <!-- Strand 3: Center-Right Statement Floral Strand & Flower Charm -->
              <div class="strand-branch strand-3-statement" id="renderStrand3" title="Strand 3: Floral Statement Beads (Tap to customize)">
                <div class="strand-beads-vertical" id="renderFloralBeads"></div>
                <div class="strand-drop-frame" id="renderDrop3"><span class="drop-placeholder-icon">🌸</span></div>
              </div>

              <!-- Strand 4: Outer-Right Pastel Beads & Key Dangle -->
              <div class="strand-branch strand-4-dangle" id="renderStrand4" title="Strand 4: Star & Bow Dangle (Tap to customize)">
                <div class="strand-beads-vertical" id="renderPastelBeads"></div>
                <div class="strand-drop-frame" id="renderDrop4"><span class="drop-placeholder-icon">🗝️</span></div>
              </div>
            </div>
          </div>

          <div class="phone-attached-counter-bar">
            <span class="counter-text" id="multiCharmsCounterText">Charms Attached: <strong>0/4</strong></span>
            <button type="button" class="reset-link-btn" id="multiResetCharmsBtn">Reset All</button>
          </div>
          <p class="charm-arrangement-hint" id="multiArrangementHint">↔ Drag charms on preview to swap strings or move</p>
        </div>

        <div class="desktop-only-action-bar">
          <div class="phone-price-breakdown">
            <div class="price-row"><span>Base Design Price:</span><strong id="multiBasePriceText">₹199.00</strong></div>
            <div class="price-row"><span>Add-ons Total:</span><strong id="multiAddonsText">₹0.00</strong></div>
            <div class="price-divider"></div>
            <div class="price-row total-row"><span class="total-label">Estimated Total:</span><span class="total-amount" id="customizerTotalMultiPrice">₹199.00</span></div>
          </div>
          <button type="button" class="phone-add-to-bag-btn" id="addMultiToBagBtn"><span>✨ Add Custom Design To Bag</span></button>
        </div>
      </div>

      <!-- ==========================================
           VIEW 3: Single-Strand Bag Clip (Single Cord + Clustered Charms)
           ========================================== -->
      <div id="stageBagClipSingleWrapper" style="display: none; width: 100%;">
        <div class="stage-header">
          <span class="stage-pill">LIVE ATELIER PREVIEW</span>
          <h2 class="stage-title">Single-Strand Bag Clip</h2>
        </div>

        <div class="unified-preview-box">
          <span class="phone-palette-tag" id="singlePaletteLabel">PASTEL DREAM PALETTE</span>

          <div class="single-cord-assembly" id="singleCordAssembly">
            <div class="keychain-clasp-wrap" id="renderClaspSingle">
              <svg class="clasp-svg" viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="40" r="28" stroke="currentColor" stroke-width="7" fill="none"/>
                <path d="M50 68 V92 M36 92 H64" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
                <circle cx="50" cy="104" r="8" stroke="currentColor" stroke-width="4" fill="none"/>
              </svg>
            </div>
            
            <div class="single-cord-stage" id="singleCordStage">
              <!-- Single Vertical Cord -->
              <div class="single-cord-strand" id="singleCordStrand">
                <div class="single-cord-line"></div>
                <div class="single-cord-bottom-ring"></div>
              </div>

              <!-- Charms clustered randomly & naturally along the cord -->
              <div class="single-cord-charms-cluster" id="singleCordCharmsCluster" role="listbox" aria-label="Single-cord charm arrangement"></div>
            </div>

            <div class="phone-floating-tooltip" id="singleTapHint"><span>Tap charms below to attach up to 7!</span></div>
          </div>

          <p class="charm-arrangement-hint" id="singleArrangementHint">↕ Drag to reorder · Arrow keys supported</p>

          <div class="phone-attached-counter-bar">
            <span class="counter-text" id="singleCharmsCounterText">Charms Attached: <strong>0/7</strong></span>
            <button type="button" class="reset-link-btn" id="singleResetCharmsBtn">Reset All</button>
          </div>
        </div>

        <div class="desktop-only-action-bar">
          <div class="phone-price-breakdown">
            <div class="price-row"><span>Base Design Price:</span><strong id="singleBasePriceText">₹100.00</strong></div>
            <div class="price-row"><span>Add-ons Total:</span><strong id="singleAddonsText">₹0.00</strong></div>
            <div class="price-divider"></div>
            <div class="price-row total-row"><span class="total-label">Estimated Total:</span><span class="total-amount" id="singleEstimatedTotal">₹100.00</span></div>
          </div>
          <button type="button" class="phone-add-to-bag-btn" id="singleDirectAddBtn"><span>✨ Add Custom Design To Bag</span></button>
        </div>
      </div>

    </div>
    <div class="customizer-stage-spacer" id="stageSpacer"></div>

    <!-- Right Column: Controls Panel -->
    <div class="customizer-controls-card">
      
      <!-- Type Switcher -->
      <div class="customizer-type-selector">
        <label class="section-label">Select Atelier Creation Type</label>
        <div class="type-switch-row">
          <button type="button" class="type-btn active" id="btnTypePhoneCharm" data-type="phone-charm">
            <span class="type-icon">📱</span>
            <span class="type-text"><strong>Phone Strap</strong><small>Wrist loop (Max 4)</small></span>
          </button>
          <button type="button" class="type-btn" id="btnTypeBagClipMulti" data-type="bag-clip-multi">
            <span class="type-icon">🗝️</span>
            <span class="type-text"><strong>Bag Clip (Multi)</strong><small>4 distinct strands</small></span>
          </button>
          <button type="button" class="type-btn" id="btnTypeBagClipSingle" data-type="bag-clip-single">
            <span class="type-icon">🎐</span>
            <span class="type-text"><strong>Bag Clip (Single)</strong><small>1 cord (Max 7)</small></span>
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="controls-nav-tabs">
        <button type="button" class="tab-btn active" data-tab="tab-clasp" id="tabBtnClasp">1. Tether Cord</button>
        <button type="button" class="tab-btn" data-tab="tab-name" id="tabBtnName">2. Custom Name</button>
        <button type="button" class="tab-btn" data-tab="tab-palette" id="tabBtnPalette">3. Color Story</button>
        <button type="button" class="tab-btn" data-tab="tab-charms" id="tabBtnCharms">4. Charms</button>
      </div>

      <form id="multiStrandCustomizerForm" class="controls-form" onsubmit="return false;">
        
        <!-- Tab 1: Clasp / Cord -->
        <div class="tab-pane active" id="tab-clasp">
          <label class="section-label" id="claspHeadingLabel">Select Tether Cord Color</label>
          <p class="section-desc" id="claspDescText">Choose your soft durable nylon cord that loops through your phone case.</p>
          
          <!-- Option Grid 1: Phone Strap (Nylon Tether Cords) -->
          <div class="option-grid clasp-selector-grid" id="claspSelectorPhone">
            <button type="button" class="option-card active" data-clasp-color="#8A58B5" data-clasp-name="Lilac Purple" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #8A58B5;"></span><span class="option-title">Lilac Purple</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#E27396" data-clasp-name="Blush Pink" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #E27396;"></span><span class="option-title">Blush Pink</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#EADBB6" data-clasp-name="Buttercream Ivory" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #EADBB6;"></span><span class="option-title">Buttercream Ivory</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#2B2B2B" data-clasp-name="Onyx Black" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #2B2B2B;"></span><span class="option-title">Onyx Black</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#88B04B" data-clasp-name="Sage Green" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #88B04B;"></span><span class="option-title">Sage Green</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#7EA7CC" data-clasp-name="Sky Blue" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #7EA7CC;"></span><span class="option-title">Sky Blue</span>
            </button>
          </div>

          <!-- Option Grid 2: Multi-Strand Bag Clip (Hardware Finishes) -->
          <div class="option-grid clasp-selector-grid" id="claspSelectorBagMulti" style="display: none;">
            <button type="button" class="option-card active" data-clasp-color="#9B6B28" data-clasp-name="Antique Brass / Vintage Gold" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #C5A059 0%, #9B6B28 100%); border: 1px solid #7D551E;"></span>
              <span class="option-title">Antique Brass / Gold</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#A0A5A3" data-clasp-name="Silver Metallic" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #E0E2E1 0%, #A0A5A3 100%); border: 1px solid #7B817F;"></span>
              <span class="option-title">Silver Metallic</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#D4AF37" data-clasp-name="Polished Classic Gold" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #FBE082 0%, #D4AF37 100%); border: 1px solid #B89324;"></span>
              <span class="option-title">Polished Gold</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#B76E79" data-clasp-name="Rose Gold" data-clasp-price="20">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #F2B5BE 0%, #B76E79 100%); border: 1px solid #9A5661;"></span>
              <span class="option-title">Rose Gold (+₹20)</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#2E2E2E" data-clasp-name="Gunmetal Black" data-clasp-price="20">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #4A4A4A 0%, #202020 100%); border: 1px solid #111111;"></span>
              <span class="option-title">Gunmetal Black (+₹20)</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#6A1E22" data-clasp-name="Crimson Burgundy" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #8B262B 0%, #6A1E22 100%); border: 1px solid #4D1216;"></span>
              <span class="option-title">Crimson Burgundy</span>
            </button>
          </div>

          <!-- Option Grid 3: Single-Strand Bag Clip (Cord & Clasp Colors) -->
          <div class="option-grid clasp-selector-grid" id="claspSelectorBagSingle" style="display: none;">
            <button type="button" class="option-card active" data-clasp-color="#9B6B28" data-clasp-name="Antique Brass & Gold" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #C5A059 0%, #9B6B28 100%); border: 1px solid #7D551E;"></span>
              <span class="option-title">Antique Brass / Gold</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#A0A5A3" data-clasp-name="Silver Metallic" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: linear-gradient(135deg, #E0E2E1 0%, #A0A5A3 100%); border: 1px solid #7B817F;"></span>
              <span class="option-title">Silver Metallic</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#8A58B5" data-clasp-name="Lilac Purple Cord" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #8A58B5;"></span>
              <span class="option-title">Lilac Purple</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#E27396" data-clasp-name="Blush Pink Cord" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #E27396;"></span>
              <span class="option-title">Blush Pink</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#EADBB6" data-clasp-name="Ivory Cream Cord" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #EADBB6;"></span>
              <span class="option-title">Ivory Cream</span>
            </button>
            <button type="button" class="option-card" data-clasp-color="#2B2B2B" data-clasp-name="Onyx Black Cord" data-clasp-price="0">
              <span class="color-swatch-circle" style="background: #2B2B2B;"></span>
              <span class="option-title">Onyx Black</span>
            </button>
          </div>

          <!-- Stepper Footer: Tab 1 -->
          <div class="stepper-nav-row">
            <span class="stepper-step-indicator">Phase 1 of 4: Base Canvas</span>
            <button type="button" class="stepper-nav-btn stepper-next-btn" id="stepperNextFromClasp">
              <span>Next: Personalize Name</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <!-- Tab 2: Custom Name -->
        <div class="tab-pane" id="tab-name">
          <label class="section-label">Personalized Name / Word</label>
          <p class="section-desc">Up to 8 characters. Acrylic letter beads strung directly along the core design.</p>
          <div class="name-input-group">
            <input type="text" id="customNameInput" maxlength="8" placeholder="e.g. CRAFT" value="CRAFT" class="custom-text-input" autocomplete="off">
            <button type="button" id="clearNameBtn" class="clear-btn">✕</button>
          </div>

          <!-- Stepper Footer: Tab 2 -->
          <div class="stepper-nav-row">
            <button type="button" class="stepper-nav-btn stepper-back-btn" id="stepperBackFromName">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <span>Back: Canvas</span>
            </button>
            <span class="stepper-step-indicator">Phase 2 of 4: Name Beads</span>
            <button type="button" class="stepper-nav-btn stepper-next-btn" id="stepperNextFromName">
              <span>Next: Color Story</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <!-- Tab 3: Color Story -->
        <div class="tab-pane" id="tab-palette">
          <label class="section-label">Select Color Palette Theme</label>
          <div class="palette-list" id="paletteSelector">
            <button type="button" class="palette-row-btn active" data-palette="fairy-garden" data-palette-name="PASTEL DREAM PALETTE" data-accent="#6BB377" data-primary="#8A58B5">
              <div class="swatch-strip"><span style="background:#8A58B5;"></span><span style="background:#6BB377;"></span><span style="background:#ECA1A6;"></span><span style="background:#FFF;"></span></div>
              <div class="palette-meta"><strong>Pastel Dream (Lilac &amp; Matcha)</strong><small>Faceted lilac beads, matcha beads, and butterflies</small></div>
            </button>
            <button type="button" class="palette-row-btn" data-palette="cherry-blossom" data-palette-name="SAKURA BLOSSOM PALETTE" data-accent="#E27396" data-primary="#B32025">
              <div class="swatch-strip"><span style="background:#B32025;"></span><span style="background:#E27396;"></span><span style="background:#F7B2BD;"></span><span style="background:#FFF;"></span></div>
              <div class="palette-meta"><strong>Sakura Blossom (Pinks &amp; Ruby)</strong><small>Rose quartz tones, frosted flowers, and blush beads</small></div>
            </button>
            <button type="button" class="palette-row-btn" data-palette="ocean-mist" data-palette-name="OCEAN MIST PALETTE" data-accent="#5BC0BE" data-primary="#3A506B">
              <div class="swatch-strip"><span style="background:#3A506B;"></span><span style="background:#5BC0BE;"></span><span style="background:#A3CEF1;"></span><span style="background:#FFF;"></span></div>
              <div class="palette-meta"><strong>Ocean Mist (Aquas &amp; Indigo)</strong><small>Clear sea-glass beads, frosted stars, and silver accents</small></div>
            </button>
          </div>

          <!-- Stepper Footer: Tab 3 -->
          <div class="stepper-nav-row">
            <button type="button" class="stepper-nav-btn stepper-back-btn" id="stepperBackFromPalette">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <span id="stepperBackFromPaletteLabel">Back: Name Beads</span>
            </button>
            <span class="stepper-step-indicator">Phase 3 of 4: Palette</span>
            <button type="button" class="stepper-nav-btn stepper-next-btn" id="stepperNextFromPalette">
              <span>Next: Select Charms</span>
