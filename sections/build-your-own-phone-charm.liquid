    // Asynchronously fetch all charms from collection JSON with automatic multi-page loading
    // Note: Shopify's products.json endpoint returns up to 250 items per page; this paginates dynamically until all items are loaded.
    function fetchAllCharmsPages(handle, maxItems) {
      var allProducts = [];
      var perPage = 250;
      var cap = maxItems || 5000;
      var maxPages = Math.ceil(cap / perPage);

      function fetchPage(page) {
        var url = '/collections/' + handle + '/products.json?limit=' + perPage + '&page=' + page;
        return fetch(url)
          .then(function(res) {
            if (!res.ok) {
              if (page === 1) throw new Error('Failed to load collection ' + handle);
              return { products: [] };
            }
            return res.json();
          })
          .then(function(data) {
            var prods = (data && Array.isArray(data.products)) ? data.products : [];
            if (prods.length === 0) return allProducts;
            allProducts = allProducts.concat(prods);
            // Fetch next page if Shopify gave a full page and we haven't reached the safety cap
            if (prods.length === perPage && page < maxPages && allProducts.length < cap) {
              return fetchPage(page + 1);
            }
            return allProducts;
          });
      }

      return fetchPage(1);
    }

    function loadAllCharmsViaAjax() {
      var grid = document.getElementById('uploadedCharmsGrid');
      if (!grid) return;

      fetchAllCharmsPages('customizer-charms', 5000)
        .then(function(prods) {
          if (!prods || prods.length === 0) {
            return fetchAllCharmsPages('charms', 5000);
          }
          return prods;
        })
        .catch(function() {
          return fetchAllCharmsPages('charms', 5000);
        })
        .then(function(products) {
          if (!products || products.length === 0) return;

          var remoteCharms = [];
          products.forEach(function(product) {
            var v = product.variants && product.variants.length > 0 ? product.variants[0] : null;
            if (!v) return;

            var priceNum = parseFloat(v.price || '0');
            var imgUrl = (product.images && product.images.length > 0) ? product.images[0].src : '';
            if (imgUrl && !imgUrl.includes('width=')) {
              imgUrl += (imgUrl.includes('?') ? '&' : '?') + 'width=160';
            }

            var cats = getCharmCategories(product.title || '', product.tags, product.product_type);
            var cat = cats[0] || 'other';
            var fin = deriveFinish(product.title || '', product.tags);
            var col = deriveColor(product.title || '', product.tags);
            var mats = getCharmMaterials(product.title || '', product.tags);
            var mat = mats.length > 0 ? mats[0] : 'other';

            remoteCharms.push({
              id: String(v.id),
              title: product.title || 'Charm',
              price: priceNum,
              img: imgUrl || '✨',
              category: cat,
              categories: cats,
              finish: fin,
              color: col,
              material: mat,
              materials: mats,
              tags: Array.isArray(product.tags) ? product.tags : (product.tags ? product.tags.split(',') : [])
            });
          });

          if (remoteCharms.length > 0) {
            allCatalogCharms = remoteCharms;
            var totalCount = allCatalogCharms.length;

            // Dynamically update UI counts
            var stepperNextSpan = document.querySelector('#stepperNextFromPalette span');
            if (stepperNextSpan) stepperNextSpan.textContent = 'Next: Select Charms (' + totalCount + '+)';
            var searchInput = document.getElementById('charmQuickSearchInput');
            if (searchInput) searchInput.setAttribute('placeholder', 'Search ' + totalCount + '+ charms by keyword...');
            var countBadge = document.getElementById('charmsCountAvailableBadge');
            if (countBadge) countBadge.textContent = totalCount + '+ Charms';

            updateCategoryCounts();
            renderCharmsPage(true);
          }
        })
        .catch(function(err) {
          console.warn('Charms AJAX load notice:', err);
        });
    }

    // Init
    var activeInitialCard = document.querySelector('.clasp-selector-grid .option-card.active');
    if (activeInitialCard) applySelectedClasp(activeInitialCard);
    renderNameBeadsVerticals();
    renderAttachedLists();
    renderSingleCordCharms();
    renderBagClipMultiStrands();
    updatePrices();
    updateMobileFloatingPill();
    updateStepperUI('tab-clasp');
    updateCategoryCounts();
    renderCharmsPage(true);
    loadAllCharmsViaAjax();
  }

  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initTitliCustomizer); } 
  else { initTitliCustomizer(); }
})();
</script>
