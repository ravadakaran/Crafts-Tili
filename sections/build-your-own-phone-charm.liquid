    function getCharmCategories(title, tags, productType) {
      var raw = (title + ' ' + (tags ? (Array.isArray(tags) ? tags.join(' ') : tags) : '') + ' ' + (productType || '')).toLowerCase();
      var text = raw.replace(/[_-]+/g, ' ').replace(/\s+/g, ' ');
      var cats = [];

      // 1. Flowers: Strictly flower, flowers, flr, flrs, blossom, tulip, daisy, rose, floral, petal, sunflower, lily, orchid, bloom, sakura
      if (/\b(flower|flowers|flr|flrs|floral|blossom|tulip|tulips|daisy|daisies|rose|roses|petal|petals|sunflower|sunflowers|orchid|orchids|lily|lilies|bloom|blooms|sakura)\b/i.test(text)) {
        cats.push('flowers');
      }

      // 2. Eye: Strictly eye, eyes, evil eye, nazar, hamsa, third eye
      if (/\b(eye|eyes|nazar|hamsa)\b/i.test(text)) {
        cats.push('eye');
      }

      // 3. Heart: Strictly heart, hearts, sweetheart, cupid, love heart
      if (/\b(heart|hearts|sweetheart|cupid)\b/i.test(text) || /\blove heart\b/i.test(text)) {
        cats.push('heart');
      }

      // 4. Butterflies, Titli: Strictly butterfly, butterflies, titli, moth, mariposa
      if (/\b(butterfly|butterflies|titli|moth|moths|mariposa)\b/i.test(text)) {
        cats.push('butterflies');
      }

      // 5. Cats: Strictly cat, cats, kitty, kitten, feline, meow
      if (/\b(cat|cats|kitty|kitten|kittens|feline|meow)\b/i.test(text)) {
        cats.push('cats');
      }

      // 6. Dogs: Strictly dog, dogs, puppy, pup, doggy, pooch, canine, dog bone, paw
      if ((/\b(dog|dogs|puppy|puppies|pup|doggy|pooch|canine)\b/i.test(text) || /\bdog bone\b/i.test(text) || /\bpaw\b/i.test(text)) && !/\bhot dog\b/i.test(text)) {
        cats.push('dogs');
      }

      // 7. Sea: Strictly sea, ocean, shell, starfish, fish, mermaid, marine, wave, dolphin, coral, oyster, conch, nautical, octopus
      if (/\b(sea|ocean|shell|shells|starfish|fish|mermaid|mermaids|marine|wave|waves|dolphin|dolphins|coral|oyster|conch|nautical|octopus)\b/i.test(text)) {
        cats.push('sea');
      }

      // 8. Leafs: Strictly leaf, leafs, leaves, clover, monstera, fern, plant, plants, vine, branch, foliage, cactus, ivy, maple
      if (/\b(leaf|leafs|leaves|clover|clovers|monstera|fern|ferns|plant|plants|vine|vines|branch|foliage|cactus|ivy|maple)\b/i.test(text)) {
        cats.push('leafs');
      }

      // 9. Ribbons: Strictly ribbon, ribbons, bow, bows, coquette, lace, knot
      if (/\b(ribbon|ribbons|bow|bows|coquette|lace|knot|knots)\b/i.test(text)) {
        cats.push('ribbons');
      }

      // 10. Avengers: Strictly avenger, avengers, marvel, mcu, iron man, captain america, thor, hulk, spiderman, spider man, black widow, hawkeye, thanos, loki, deadpool, wolverine, shield, mjolnir, arc reactor, infinity gauntlet
      if (/\b(avenger|avengers|marvel|mcu|iron\s*man|captain\s*america|thor|hulk|spiderman|spider\s*man|black\s*widow|hawkeye|thanos|loki|deadpool|wolverine|shield|mjolnir|arc\s*reactor|infinity\s*gauntlet)\b/i.test(text)) {
        cats.push('avengers');
      }

      // 11. Harry Potter: Strictly harry potter, potter, hogwarts, gryffindor, slytherin, hufflepuff, ravenclaw, dumbledore, hermione, voldemort, deathly hallows, snitch, golden snitch, quidditch, wizard, wand
      if (/\b(harry\s*potter|potter|hogwarts|gryffindor|slytherin|hufflepuff|ravenclaw|dumbledore|hermione|voldemort|deathly\s*hallows|snitch|golden\s*snitch|quidditch|wizard|wand)\b/i.test(text)) {
        cats.push('harrypotter');
      }

      // 12. Stitch / Stnitch: Strictly stitch, stnitch, lilo, experiment 626
      if (/\b(stitch|stnitch|lilo|experiment\s*626)\b/i.test(text)) {
        cats.push('stitch');
      }

      // 13. HTD (How to Train Your Dragon): Strictly htd, httyd, toothless, light fury, night fury, hiccup, dragon, dragons, how to train your dragon
      if (/\b(htd|httyd|toothless|light\s*fury|night\s*fury|hiccup|dragon|dragons|how\s*to\s*train\s*your\s*dragon)\b/i.test(text)) {
        cats.push('htd');
      }

      // 14. Minions (mininons): Strictly minion, minions, mininon, mininons, despicable me, kevin, stuart, gru, banana minion
      if (/\b(minion|minions|mininon|mininons|despicable\s*me|kevin|stuart|gru)\b/i.test(text) || (/\b(bob)\b/i.test(text) && /minion|despicable/i.test(text))) {
        cats.push('minions');
      }

      // STRICT: Charms not matching any specific aesthetic or theme categories do NOT receive a fallback.
      // They belong exclusively to "All Charms" so categories remain 100% clean and pure.
      return cats;
    }

    function categorizeCharm(title, tags, productType) {
      var cats = getCharmCategories(title, tags, productType);
      return cats.length > 0 ? cats[0] : 'other';
    }

    function deriveFinish(title, tags) {
      var text = (title + ' ' + (tags ? (Array.isArray(tags) ? tags.join(' ') : tags) : '')).toLowerCase();
      if (/gold|brass|amber|gilt/i.test(text)) return 'gold';
      if (/silver|chrome|rhodium|steel|metallic/i.test(text)) return 'silver';
      if (/enamel|paint|pastel|color|colorful|pink|blue|green|lilac/i.test(text)) return 'enamel';
      if (/pearl|shell|nacre/i.test(text)) return 'pearl';
      if (/crystal|glass|acrylic|resin|prism|quartz|zirconia|rhinestone/i.test(text)) return 'crystal';
      return 'gold';
    }

    function deriveColor(title, tags) {
      var text = (title + ' ' + (tags ? (Array.isArray(tags) ? tags.join(' ') : tags) : '')).toLowerCase().replace(/[^a-z0-9]+/g, ' ');
      if (/\b(pink|rose|blush|peach|coral|magenta|fuchsia)\b/i.test(text)) return 'pink';
      if (/\b(blue|azure|navy|sapphire|aqua|cyan|teal|sky|ocean)\b/i.test(text)) return 'blue';
      if (/\b(purple|violet|lilac|lavender|plum|amethyst|mauve)\b/i.test(text)) return 'purple';
      if (/\b(green|emerald|mint|sage|olive|jade|leaf|leaves|fern|clover|plant|cactus)\b/i.test(text)) return 'green';
      if (/\b(gold|golden|yellow|amber|sun|mustard|honey)\b/i.test(text)) return 'gold';
      if (/\b(silver|grey|gray|chrome|rhodium|steel|metallic)\b/i.test(text)) return 'silver';
      if (/\b(white|pearl|ivory|cream|clear|opal|cloud)\b/i.test(text)) return 'white';
      if (/\b(black|onyx|dark|midnight|noir|charcoal|obsidian)\b/i.test(text)) return 'black';
      if (/\b(red|crimson|ruby|cherry|scarlet|burgundy|maroon)\b/i.test(text)) return 'red';

      // Characteristic semantic fallbacks
      if (/love|heart|bow|ribbon|ballet|cupid|sweetheart|strawberry|berry|kiss/i.test(text)) return 'pink';
      if (/eye|nazar|wave|sea|shell|starfish|dolphin|water|rain/i.test(text)) return 'blue';
      if (/flower|blossom|tulip|daisy|orchid|bloom/i.test(text)) return 'pink';
      if (/cat|kitty|moon|star|planet|cosmos|night/i.test(text)) return 'purple';
      if (/dog|puppy|paw|bone/i.test(text)) return 'gold';
      if (/avenger|marvel|iron\s*man|spiderman|captain\s*america/i.test(text)) return 'red';
      if (/harry\s*potter|potter|snitch|gryffindor|hogwarts/i.test(text)) return 'gold';
      if (/stitch|stnitch|lilo/i.test(text)) return 'blue';
      if (/toothless|htd|httyd|dragon/i.test(text)) return 'black';
      if (/minion|mininon|banana/i.test(text)) return 'gold';

      var hash = 0;
      for (var i = 0; i < text.length; i++) hash = ((hash << 5) - hash) + text.charCodeAt(i);
      var fallbacks = ['pink', 'blue', 'purple', 'green', 'gold', 'silver', 'white', 'black', 'red'];
      return fallbacks[Math.abs(hash) % fallbacks.length];
    }

    function getCharmMaterials(title, tags) {
      var raw = (title + ' ' + (tags ? (Array.isArray(tags) ? tags.join(' ') : tags) : '')).toLowerCase();
      var text = raw.replace(/[_-]+/g, ' ').replace(/\s+/g, ' ');
      var mats = [];

      // 1. Glossy
      if (/\b(glossy|gloss|shine|shiny)\b/i.test(text)) {
        mats.push('glossy');
      }

      // 2. Matt (matches matt and matte)
      if (/\b(matt|matte)\b/i.test(text)) {
        mats.push('matt');
      }

      // 3. Silver (matches silver, sliver typo, chrome, rhodium, steel)
      if (/\b(silver|sliver|chrome|rhodium|steel)\b/i.test(text)) {
        mats.push('silver');
      }

      // 4. Gold (matches gold, golden, gilt, brass)
      if (/\b(gold|golden|gilt|brass)\b/i.test(text)) {
        mats.push('gold');
      }

      // 5. Copper
      if (/\b(copper)\b/i.test(text)) {
        mats.push('copper');
      }

      // 6. Bronze
      if (/\b(bronze)\b/i.test(text)) {
        mats.push('bronze');
      }

      // 7. Glassy (matches glassy, glass, crystal, transparent, trasperent)
      if (/\b(glassy|glass|crystal|transparent|trasperent)\b/i.test(text)) {
        mats.push('glassy');
      }

      return mats;
    }

    function deriveMaterial(title, tags) {
      var mats = getCharmMaterials(title, tags);
      return mats.length > 0 ? mats[0] : 'other';
    }

    SEED_CHARMS.forEach(function(c) {
      if (!c.color) c.color = deriveColor(c.title, c.tags);
      if (!c.material || c.material === 'metal' || c.material === 'enamel') {
        c.materials = getCharmMaterials(c.title, c.tags);
        if (c.materials.length === 0) {
          if (c.finish === 'silver') c.materials.push('silver');
          else if (c.finish === 'crystal') c.materials.push('glassy');
          else if (c.finish === 'gold') c.materials.push('gold');
          else c.materials.push('glossy');
        }
        c.material = c.materials[0];
      }
    });

    var allCatalogCharms = SEED_CHARMS.slice();
    var charmsState = {
      activeCategory: 'all',
      activeColor: 'all',
      activeMaterial: 'all',
      activePriceTier: 'all',
      searchTerm: '',
      sortOrder: 'featured',
      loadedCount: 24,
      batchSize: 24,
      isLoadingMore: false
    };

    function getFilteredCharms() {
      var list = allCatalogCharms.slice();

      // Category filter
      if (charmsState.activeCategory !== 'all') {
        list = list.filter(function(c) {
          if (c.categories && Array.isArray(c.categories)) {
            return c.categories.indexOf(charmsState.activeCategory) > -1;
          }
          return c.category === charmsState.activeCategory;
        });
      }

      // Colour filter
      if (charmsState.activeColor !== 'all') {
        list = list.filter(function(c) {
          return c.color === charmsState.activeColor;
        });
      }

      // Material filter
      if (charmsState.activeMaterial !== 'all') {
        list = list.filter(function(c) {
          if (c.materials && Array.isArray(c.materials)) {
            return c.materials.indexOf(charmsState.activeMaterial) > -1;
          }
          return c.material === charmsState.activeMaterial;
        });
      }

      // Price Tier filter
      if (charmsState.activePriceTier === 'tier-low') {
        list = list.filter(function(c) { return c.price < 20; });
      } else if (charmsState.activePriceTier === 'tier-mid') {
        list = list.filter(function(c) { return c.price >= 20 && c.price <= 35; });
      } else if (charmsState.activePriceTier === 'tier-high') {
        list = list.filter(function(c) { return c.price > 35; });
      }

      // Search term
      if (charmsState.searchTerm) {
        var term = charmsState.searchTerm.toLowerCase();
        list = list.filter(function(c) {
          var t = (c.title || '').toLowerCase();
          var tagsStr = (c.tags && Array.isArray(c.tags)) ? c.tags.join(' ').toLowerCase() : '';
          return t.indexOf(term) > -1 || tagsStr.indexOf(term) > -1;
        });
      }

      // Sort
      if (charmsState.sortOrder === 'price-asc') {
        list.sort(function(a, b) { return a.price - b.price; });
      } else if (charmsState.sortOrder === 'price-desc') {
        list.sort(function(a, b) { return b.price - a.price; });
      } else if (charmsState.sortOrder === 'title-asc') {
        list.sort(function(a, b) { return a.title.localeCompare(b.title); });
      }

      return list;
    }

    function createCharmCardElement(c) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'charm-product-card';
      btn.setAttribute('data-charm-id', c.id);
      btn.setAttribute('data-charm-title', c.title);
      btn.setAttribute('data-charm-price', c.price);
      btn.setAttribute('data-charm-img', c.img);
      btn.setAttribute('data-charm-category', c.category);
      btn.setAttribute('data-charm-finish', c.finish || 'gold');
      btn.setAttribute('data-charm-color', c.color || 'gold');
      btn.setAttribute('data-charm-material', c.material || 'metal');

      var imgWrap = document.createElement('div');
      imgWrap.className = 'charm-img-wrap' + (!c.img.includes('/') && !c.img.startsWith('http') ? ' charm-emoji-wrap' : '');
      if (c.img.includes('/') || c.img.startsWith('http')) {
        var img = document.createElement('img');
        img.src = c.img;
        img.alt = c.title;
        img.loading = 'lazy';
        imgWrap.appendChild(img);
      } else {
        var fallback = document.createElement('span');
        fallback.textContent = c.img;
        imgWrap.appendChild(fallback);
      }
      btn.appendChild(imgWrap);

      var titleSpan = document.createElement('span');
      titleSpan.className = 'charm-card-title';
      titleSpan.textContent = c.title.length > 18 ? c.title.slice(0, 18) + '...' : c.title;
      btn.appendChild(titleSpan);

      var priceSpan = document.createElement('span');
      priceSpan.className = 'charm-card-price';
      priceSpan.textContent = '+₹' + parseFloat(c.price).toFixed(2);
      btn.appendChild(priceSpan);

      var checkBadge = document.createElement('span');
      checkBadge.className = 'charm-check-badge';
      checkBadge.textContent = '✓';
      btn.appendChild(checkBadge);

      var zoomTrigger = document.createElement('span');
      zoomTrigger.className = 'charm-zoom-trigger';
      zoomTrigger.title = 'Inspect Charm';
      zoomTrigger.setAttribute('aria-label', 'Zoom charm');
      zoomTrigger.textContent = '🔍';
      btn.appendChild(zoomTrigger);

      return btn;
    }

    function renderCharmsPage(keepScroll) {
      var grid = document.getElementById('uploadedCharmsGrid');
      if (!grid) return;

      var filtered = getFilteredCharms();
      var totalItems = filtered.length;

      if (!keepScroll || charmsState.loadedCount < charmsState.batchSize) {
        charmsState.loadedCount = Math.min(charmsState.batchSize, totalItems);
      } else {
        charmsState.loadedCount = Math.min(charmsState.loadedCount, totalItems);
      }
      var visibleItems = filtered.slice(0, charmsState.loadedCount);

      // Results stat
      var summaryEl = document.getElementById('charmsResultsSummary');
      if (summaryEl) {
        if (totalItems === 0) {
          summaryEl.innerHTML = '<strong>0 Charms</strong> found';
        } else {
          summaryEl.innerHTML = 'Showing <strong>' + visibleItems.length + '</strong> of <strong>' + totalItems + '</strong> Charms';
        }
      }

      var badge = document.getElementById('charmsCountAvailableBadge');
      if (badge) {
        badge.textContent = allCatalogCharms.length + '+ Charms';
      }

      // Clear filters button
      var resetBtn = document.getElementById('charmsResetFiltersBtn');
      if (resetBtn) {
        var hasActiveFilters = charmsState.activeCategory !== 'all' || 
                               charmsState.activeColor !== 'all' || 
                               charmsState.activeMaterial !== 'all' || 
                               charmsState.activePriceTier !== 'all' || 
                               charmsState.searchTerm !== '';
        resetBtn.style.display = hasActiveFilters ? 'inline-block' : 'none';
      }

      var loadMoreBtn = document.getElementById('charmsLoadMoreBtn');
      var loadMoreText = document.getElementById('charmsLoadMoreBtnText');
      var loadMoreSpinner = document.getElementById('charmsLoadMoreSpinner');
      var loadMoreProgress = document.getElementById('charmsLoadMoreProgress');
      var endEl = document.getElementById('charmsEndOfCatalog');

      if (loadMoreSpinner) loadMoreSpinner.style.display = 'none';
      if (loadMoreBtn) loadMoreBtn.disabled = false;

      if (totalItems === 0) {
        grid.innerHTML = '<div class="charms-empty-state"><span class="empty-icon">🔍</span><h4>No matching charms found</h4><p>Try resetting your colour, material, or keyword filters.</p><button type="button" class="charms-reset-filters-btn" id="emptyResetFiltersBtn">Reset All Filters ✕</button></div>';
        var emptyReset = document.getElementById('emptyResetFiltersBtn');
        if (emptyReset) {
          emptyReset.addEventListener('click', resetAllCharmFilters);
        }
        if (loadMoreBtn) loadMoreBtn.style.display = 'none';
        if (loadMoreProgress) loadMoreProgress.style.display = 'none';
        if (endEl) endEl.style.display = 'none';
        return;
      }

      var fragment = document.createDocumentFragment();
      visibleItems.forEach(function(c) {
        fragment.appendChild(createCharmCardElement(c));
      });

      grid.innerHTML = '';
      grid.appendChild(fragment);

      // Manage Load More button & catalog completion status
      if (visibleItems.length < totalItems) {
        if (loadMoreBtn) {
          loadMoreBtn.style.display = 'inline-flex';
          var remaining = totalItems - visibleItems.length;
          var nextCount = Math.min(charmsState.batchSize, remaining);
          if (loadMoreText) loadMoreText.textContent = 'Load More Charms (+' + nextCount + ')';
        }
        if (loadMoreProgress) {
          loadMoreProgress.style.display = 'block';
          var loadedProg = document.getElementById('charmsLoadedProgressNum');
          var totalProg = document.getElementById('charmsTotalProgressNum');
          if (loadedProg) loadedProg.textContent = visibleItems.length;
          if (totalProg) totalProg.textContent = totalItems;
        }
        if (endEl) endEl.style.display = 'none';
      } else {
        if (loadMoreBtn) loadMoreBtn.style.display = 'none';
        if (loadMoreProgress) loadMoreProgress.style.display = 'none';
        if (endEl) {
          endEl.style.display = 'flex';
          var endText = document.getElementById('charmsEndNoticeText');
          if (endText) {
            endText.textContent = totalItems <= charmsState.batchSize 
              ? '✨ All ' + totalItems + ' matching charms shown' 
              : "✨ You've explored all " + totalItems + ' charms in this view';
          }
        }
      }

      syncCharmsGridActiveState();

      if (!keepScroll && grid) {
        var cardBox = grid.closest('.customizer-controls-card');
        if (cardBox && window.innerWidth <= 880) {
          grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    }

    function loadMoreCharms() {
      if (charmsState.isLoadingMore) return;
      var grid = document.getElementById('uploadedCharmsGrid');
      if (!grid) return;

      var filtered = getFilteredCharms();
      var totalItems = filtered.length;
      if (charmsState.loadedCount >= totalItems) return;

      charmsState.isLoadingMore = true;
      var loadMoreBtn = document.getElementById('charmsLoadMoreBtn');
      var loadMoreSpinner = document.getElementById('charmsLoadMoreSpinner');
      var loadMoreText = document.getElementById('charmsLoadMoreBtnText');

      if (loadMoreBtn) loadMoreBtn.disabled = true;
      if (loadMoreSpinner) loadMoreSpinner.style.display = 'inline-block';
      if (loadMoreText) loadMoreText.textContent = 'Loading Charms...';

      setTimeout(function() {
        var nextBatchStart = charmsState.loadedCount;
        var nextBatchEnd = Math.min(nextBatchStart + charmsState.batchSize, totalItems);
        var nextItems = filtered.slice(nextBatchStart, nextBatchEnd);

        var fragment = document.createDocumentFragment();
        nextItems.forEach(function(c) {
          fragment.appendChild(createCharmCardElement(c));
        });

        grid.appendChild(fragment);
        charmsState.loadedCount = nextBatchEnd;
        charmsState.isLoadingMore = false;

        if (loadMoreSpinner) loadMoreSpinner.style.display = 'none';
        if (loadMoreBtn) loadMoreBtn.disabled = false;

        var summaryEl = document.getElementById('charmsResultsSummary');
        if (summaryEl) {
          summaryEl.innerHTML = 'Showing <strong>' + charmsState.loadedCount + '</strong> of <strong>' + totalItems + '</strong> Charms';
        }

        var loadMoreProgress = document.getElementById('charmsLoadMoreProgress');
        var endEl = document.getElementById('charmsEndOfCatalog');

        if (charmsState.loadedCount < totalItems) {
          if (loadMoreBtn) {
            loadMoreBtn.style.display = 'inline-flex';
            var remaining = totalItems - charmsState.loadedCount;
            var nextCount = Math.min(charmsState.batchSize, remaining);
            if (loadMoreText) loadMoreText.textContent = 'Load More Charms (+' + nextCount + ')';
          }
          if (loadMoreProgress) {
            loadMoreProgress.style.display = 'block';
            var loadedProg = document.getElementById('charmsLoadedProgressNum');
            var totalProg = document.getElementById('charmsTotalProgressNum');
            if (loadedProg) loadedProg.textContent = charmsState.loadedCount;
            if (totalProg) totalProg.textContent = totalItems;
          }
          if (endEl) endEl.style.display = 'none';
        } else {
          if (loadMoreBtn) loadMoreBtn.style.display = 'none';
          if (loadMoreProgress) loadMoreProgress.style.display = 'none';
          if (endEl) {
            endEl.style.display = 'flex';
            var endText = document.getElementById('charmsEndNoticeText');
            if (endText) {
              endText.textContent = "✨ You've explored all " + totalItems + ' charms in this view';
            }
          }
        }

        syncCharmsGridActiveState();
      }, 100);
    }

    function updateCategoryCounts() {
      var counts = {
        all: allCatalogCharms.length,
        avengers: 0,
        harrypotter: 0,
        stitch: 0,
        htd: 0,
        minions: 0,
        flowers: 0,
        eye: 0,
        heart: 0,
        butterflies: 0,
        cats: 0,
        dogs: 0,
        sea: 0,
        leafs: 0,
        ribbons: 0
      };

      allCatalogCharms.forEach(function(c) {
        if (c.categories && Array.isArray(c.categories)) {
          c.categories.forEach(function(cat) {
            if (counts[cat] !== undefined) counts[cat]++;
          });
        } else if (counts[c.category] !== undefined) {
          counts[c.category]++;
        }
      });

      var allEl = document.getElementById('catCountAll');
      if (allEl) allEl.textContent = counts.all + (counts.all >= 100 ? '+' : '');

      var catIdMap = {
        avengers: 'catCountAvengers',
        harrypotter: 'catCountHarryPotter',
        stitch: 'catCountStitch',
        htd: 'catCountHtd',
        minions: 'catCountMinions',
        flowers: 'catCountFlowers',
        eye: 'catCountEye',
        heart: 'catCountHeart',
        butterflies: 'catCountButterflies',
        cats: 'catCountCats',
        dogs: 'catCountDogs',
        sea: 'catCountSea',
        leafs: 'catCountLeafs',
        ribbons: 'catCountRibbons'
      };

      Object.keys(catIdMap).forEach(function(cat) {
        var el = document.getElementById(catIdMap[cat]);
        if (el) el.textContent = counts[cat] > 0 ? counts[cat] : '';
      });
    }

