        if (phonePaletteLabel) phonePaletteLabel.textContent = state.paletteName;
        if (singlePaletteLabel) singlePaletteLabel.textContent = state.paletteName;
        if (multiPaletteLabel) multiPaletteLabel.textContent = state.paletteName;
        
        renderNameBeadsVerticals();
        renderBagClipMultiStrands();
      });
