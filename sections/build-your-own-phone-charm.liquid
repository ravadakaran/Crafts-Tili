          document.getElementById('charmsListDesc').textContent = 'Tap any charm to attach it to your piece. Tap again to remove.';
          document.getElementById('charmsLimitBadge').textContent = 'Max 4 Charms';
        }
        
        syncCharmsGridActiveState();
        updatePrices();
        renderBagClipMultiStrands();
        renderNameBeadsVerticals();
        renderSingleCordCharms();
      });
    });

    // 2. Phased Stepper & Navigation Tabs
    // 2. Navigation Tabs Logic
    var tabBtns = document.querySelectorAll('.controls-nav-tabs .tab-btn');
    var tabPanes = document.querySelectorAll('.tab-pane');

    function updateStepperUI(activeTabId) {
      tabBtns.forEach(function(b) {
        if (b.getAttribute('data-tab') === activeTabId) {
          b.classList.add('active');
          try {
            b.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } catch(e) {}
        } else {
          b.classList.remove('active');
        }
      });

      tabPanes.forEach(function(p) {
        if (p.id === activeTabId) p.classList.add('active');
        else p.classList.remove('active');
      });

      var isSingleCord = state.modelType === 'bag-clip-single';
      var tabBtnName = document.getElementById('tabBtnName');
      if (tabBtnName) {
        tabBtnName.style.display = isSingleCord ? 'none' : 'inline-block';
      }
    }

    function switchTab(targetId) {
      if (!targetId) return;
      tabBtns.forEach(function(b) {
        if (b.getAttribute('data-tab') === targetId) b.classList.add('active');
        else b.classList.remove('active');
      });
      tabPanes.forEach(function(p) {
        if (p.id === targetId) p.classList.add('active');
        else p.classList.remove('active');
      });
      updateStepperUI(targetId);

      // In case we switched to charms tab, sync active state & setup infinite scroll observer
      if (targetId === 'tab-charms') {
        syncCharmsGridActiveState();
        setupInfiniteScrollObserver();
      }
    }

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var tabId = btn.getAttribute('data-tab');
        switchTab(tabId);
      });
    });

    // Stepper Footer Buttons
    var nextFromClaspBtn = document.getElementById('stepperNextFromClasp');
    if (nextFromClaspBtn) {
      nextFromClaspBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (state.modelType === 'bag-clip-single') {
          switchTab('tab-palette');
        } else {
          switchTab('tab-name');
        }
      });
    }

    var backFromNameBtn = document.getElementById('stepperBackFromName');
    if (backFromNameBtn) {
      backFromNameBtn.addEventListener('click', function(e) {
        e.preventDefault();
        switchTab('tab-clasp');
      });
    }

    var nextFromNameBtn = document.getElementById('stepperNextFromName');
    if (nextFromNameBtn) {
      nextFromNameBtn.addEventListener('click', function(e) {
        e.preventDefault();
        switchTab('tab-palette');
      });
    }

    var backFromPaletteBtn = document.getElementById('stepperBackFromPalette');
    if (backFromPaletteBtn) {
      backFromPaletteBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (state.modelType === 'bag-clip-single') {
          switchTab('tab-clasp');
        } else {
          switchTab('tab-name');
        }
      });
    }

    var nextFromPaletteBtn = document.getElementById('stepperNextFromPalette');
