    // Click on attached multi drops to quickly remove charm
    [1, 2, 3, 4].forEach(function(sNum) {
      var dropEl = document.getElementById('renderDrop' + sNum);
      if (dropEl) {
        dropEl.addEventListener('click', function(e) {
          if (Date.now() < suppressCharmClickUntil) return;
          if (state.bagClipCharms[sNum]) {
            var cTitle = state.bagClipCharms[sNum].title;
            state.bagClipCharms[sNum] = null;
            showCustomizerToast('Removed ' + cTitle + ' from string ' + sNum);
            renderBagClipMultiDrops();
            syncCharmsGridActiveState();
            updatePrices();
            updateMobileFloatingPill();
          }
        });
      }
    });

    function handleCharmCardClick(card) {
      if (!card) return;
      var charmId = card.getAttribute('data-charm-id');
      var charmTitle = card.getAttribute('data-charm-title');
      var charmPrice = parseFloat(card.getAttribute('data-charm-price') || '0');
      var charmImg = card.getAttribute('data-charm-img');

      if (state.modelType === 'bag-clip-multi') {
        // 1. If already attached to ANY strand, toggle it off/remove it
        var attachedStrand = null;
        for (var s = 1; s <= 4; s++) {
          if (state.bagClipCharms[s] && String(state.bagClipCharms[s].id) === String(charmId)) {
            attachedStrand = s;
            break;
          }
        }

        if (attachedStrand !== null) {
          state.bagClipCharms[attachedStrand] = null;
          showCustomizerToast('Removed ' + charmTitle + ' from string ' + attachedStrand);
        } else {
          // 2. Auto-fill the next available empty string (1 -> 2 -> 3 -> 4)
          var nextEmptyStrand = null;
          for (var es = 1; es <= 4; es++) {
            if (!state.bagClipCharms[es]) {
              nextEmptyStrand = es;
              break;
            }
          }

          if (!nextEmptyStrand) {
            showCustomizerToast('All 4 strings are full! Drag on preview to swap, or tap a charm to remove.');
            return;
          }

          state.bagClipCharms[nextEmptyStrand] = { id: charmId, title: charmTitle, price: charmPrice, img: charmImg };
          showCustomizerToast('✨ ' + charmTitle + ' attached to string ' + nextEmptyStrand);
        }
        renderBagClipMultiDrops();
        
      } else if (state.modelType === 'bag-clip-single') {
        var bsIndex = state.bagClipSingleCharms.findIndex(function(c) { return String(c.id) === String(charmId); });
        if (bsIndex > -1) {
          state.bagClipSingleCharms.splice(bsIndex, 1);
          showCustomizerToast('Removed ' + charmTitle + ' (' + state.bagClipSingleCharms.length + '/7)');
        } else {
          if (state.bagClipSingleCharms.length >= 7) { alert('You can attach up to 7 charms along this single cord.'); return; }
          state.bagClipSingleCharms.push({ id: charmId, title: charmTitle, price: charmPrice, img: charmImg });
          showCustomizerToast('✨ ' + charmTitle + ' attached (' + state.bagClipSingleCharms.length + '/7)');
        }
        renderSingleCordCharms();
        
      } else {
        var pIndex = state.phoneCharms.findIndex(function(c) { return String(c.id) === String(charmId); });
        if (pIndex > -1) {
          state.phoneCharms.splice(pIndex, 1);
          showCustomizerToast('Removed ' + charmTitle + ' (' + state.phoneCharms.length + '/4)');
        } else {
          if (state.phoneCharms.length >= 4) { alert('You can attach up to 4 charms per piece.'); return; }
          state.phoneCharms.push({ id: charmId, title: charmTitle, price: charmPrice, img: charmImg });
          showCustomizerToast('✨ ' + charmTitle + ' attached (' + state.phoneCharms.length + '/4)');
        }
        renderAttachedLists();
      }

      syncCharmsGridActiveState();
      updatePrices();
      updateMobileFloatingPill();
    }

