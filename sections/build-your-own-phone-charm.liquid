      { side: 'bottom', top: 73, rotate: 0,  connLen: 8 },
      { side: 'left',   top: 62, rotate: -5, connLen: 11 },
      { side: 'right',  top: 52, rotate: 5,  connLen: 11 },
      { side: 'left',   top: 42, rotate: -4, connLen: 13 },
      { side: 'right',  top: 32, rotate: 5,  connLen: 13 },
      { side: 'left',   top: 22, rotate: -4, connLen: 10 },
      { side: 'right',  top: 12, rotate: 4,  connLen: 10 }
    ];

    // Pointer Events support mouse, pen, and touch with one reorder interaction.
    var charmDrag = null;
    var suppressCharmClickUntil = 0;

    function moveArrayItem(items, fromIndex, toIndex) {
      if (fromIndex === toIndex || fromIndex < 0 || toIndex < 0 || fromIndex >= items.length || toIndex >= items.length) return false;
      var moved = items.splice(fromIndex, 1)[0];
      items.splice(toIndex, 0, moved);
      return true;
    }

    function updateArrangementHints() {
      if (phoneArrangementHint) phoneArrangementHint.classList.toggle('is-visible', state.phoneCharms.length > 1);
      if (singleArrangementHint) singleArrangementHint.classList.toggle('is-visible', state.bagClipSingleCharms.length > 1);
      var multiCount = [1, 2, 3, 4].filter(function(s) { return !!state.bagClipCharms[s]; }).length;
      if (multiArrangementHint) multiArrangementHint.classList.toggle('is-visible', multiCount > 0);
    }

    function renderReorderedCharms(type) {
      if (type === 'phone') renderAttachedLists();
      else if (type === 'single') renderSingleCordCharms();
      else renderBagClipMultiDrops();
      syncCharmsGridActiveState();
      updateMobileFloatingPill();
      updateArrangementHints();
    }

    function reorderCharm(type, fromIndex, toIndex) {
      var changed = false;
      if (type === 'phone') changed = moveArrayItem(state.phoneCharms, fromIndex, toIndex);
      else if (type === 'single') changed = moveArrayItem(state.bagClipSingleCharms, fromIndex, toIndex);
      else if (type === 'multi' && fromIndex !== toIndex) {
        var sourceCharm = state.bagClipCharms[fromIndex];
        var destCharm = state.bagClipCharms[toIndex];
        state.bagClipCharms[fromIndex] = destCharm;
        state.bagClipCharms[toIndex] = sourceCharm;
        state.activeStrandTarget = toIndex;
        changed = true;
      }
      if (!changed) return false;
      renderReorderedCharms(type);
      updatePrices();
      if (type === 'multi') {
        var isSwap = state.bagClipCharms[fromIndex] && state.bagClipCharms[toIndex];
        showCustomizerToast(isSwap ? 'Swapped strings ' + fromIndex + ' & ' + toIndex : 'Moved charm to string ' + toIndex);
      } else {
        showCustomizerToast('Charm arrangement updated');
      }
      return true;
    }

    function clearCharmDropTargets() {
      if (!appRoot) return;
      appRoot.querySelectorAll('.is-drop-target').forEach(function(el) { el.classList.remove('is-drop-target'); });
    }

    function closestCharmDropTarget(type, clientX, clientY) {
      if (!appRoot) return null;
      if (type === 'multi') {
        var drops = [renderDrop1, renderDrop2, renderDrop3, renderDrop4];
        var strands = [
          document.getElementById('renderStrand1'),
          document.getElementById('renderStrand2'),
          document.getElementById('renderStrand3'),
          document.getElementById('renderStrand4')
        ];
        var closest = null;
        var closestDistance = Infinity;
        for (var i = 0; i < 4; i++) {
          var dropEl = drops[i];
          var strandEl = strands[i];
          if (!dropEl) continue;
          var dropRect = dropEl.getBoundingClientRect();
          var dropDist = Math.hypot(clientX - (dropRect.left + dropRect.width / 2), clientY - (dropRect.top + dropRect.height / 2));
          var strandDist = Infinity;
          if (strandEl) {
            var strandRect = strandEl.getBoundingClientRect();
            var clampY = Math.max(strandRect.top, Math.min(clientY, strandRect.bottom));
            strandDist = Math.hypot(clientX - (strandRect.left + strandRect.width / 2), clientY - clampY);
          }
          var effectiveDist = Math.min(dropDist, strandDist);
          if (effectiveDist < closestDistance) {
            closestDistance = effectiveDist;
            closest = dropEl;
          }
        }
        return closestDistance <= 115 ? closest : null;
      }

      var targets = appRoot.querySelectorAll('[data-reorder-type="' + type + '"]');
      var closest = null;
      var closestDistance = Infinity;
      targets.forEach(function(target) {
        var rect = target.getBoundingClientRect();
        var dx = clientX - (rect.left + rect.width / 2);
        var dy = clientY - (rect.top + rect.height / 2);
        var distance = Math.sqrt(dx * dx + dy * dy);
        if (distance < closestDistance) {
          closest = target;
          closestDistance = distance;
        }
      });
      return closestDistance <= 90 ? closest : null;
    }

    function positionCharmGhost(clientX, clientY) {
      if (!charmDrag || !charmDrag.ghost) return;
      charmDrag.ghost.style.left = clientX + 'px';
      charmDrag.ghost.style.top = clientY + 'px';
    }

    function finishCharmDrag(event, cancelled) {
      if (!charmDrag || event.pointerId !== charmDrag.pointerId) return;
      var finishedDrag = charmDrag;
      charmDrag = null;
      clearCharmDropTargets();
      document.body.classList.remove('is-reordering-charm');
      finishedDrag.source.classList.remove('is-drag-source');
      if (finishedDrag.ghost) finishedDrag.ghost.remove();

      if (!cancelled && finishedDrag.started) {
        suppressCharmClickUntil = Date.now() + 400;
        var target = closestCharmDropTarget(finishedDrag.type, event.clientX, event.clientY);
        if (target) {
          var toIndex = parseInt(target.getAttribute('data-reorder-index'), 10);
          reorderCharm(finishedDrag.type, finishedDrag.fromIndex, toIndex);
        }
      }
    }

    function bindCharmReorder(item, type, index, label) {
      item.setAttribute('data-charm-reorder', 'true');
      item.setAttribute('data-reorder-type', type);
      item.setAttribute('data-reorder-index', index);
      item.setAttribute('tabindex', '0');
      item.setAttribute('role', 'option');
      item.setAttribute('aria-posinset', type === 'multi' ? index : index + 1);
      item.setAttribute('aria-setsize', type === 'multi' ? 4 : (type === 'phone' ? state.phoneCharms.length : state.bagClipSingleCharms.length));
      item.setAttribute('aria-label', label + '. Drag to rearrange, or use arrow keys.');
      item.querySelectorAll('img').forEach(function(img) { img.setAttribute('draggable', 'false'); });
      if (item.getAttribute('data-reorder-bound') === 'true') return;
      item.setAttribute('data-reorder-bound', 'true');

      item.addEventListener('pointerdown', function(event) {
        if (event.button !== 0 || charmDrag || !item.hasAttribute('data-charm-reorder')) return;
        var currentType = item.getAttribute('data-reorder-type');
        var currentIndex = parseInt(item.getAttribute('data-reorder-index'), 10);
        if (item.setPointerCapture) item.setPointerCapture(event.pointerId);
        charmDrag = {
          pointerId: event.pointerId,
          type: currentType,
          fromIndex: currentIndex,
          source: item,
          startX: event.clientX,
          startY: event.clientY,
          started: false,
          ghost: null
        };
      });

      item.addEventListener('keydown', function(event) {
        var backwards = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
        var forwards = event.key === 'ArrowRight' || event.key === 'ArrowDown';
        if (!backwards && !forwards) return;
        event.preventDefault();
        var currentType = item.getAttribute('data-reorder-type');
        var currentIndex = parseInt(item.getAttribute('data-reorder-index'), 10);
        var maxIndex = currentType === 'multi' ? 4 : (currentType === 'phone' ? state.phoneCharms.length - 1 : state.bagClipSingleCharms.length - 1);
        var minIndex = currentType === 'multi' ? 1 : 0;
        var toIndex = Math.max(minIndex, Math.min(maxIndex, currentIndex + (backwards ? -1 : 1)));
        if (reorderCharm(currentType, currentIndex, toIndex)) {
          window.requestAnimationFrame(function() {
            var moved = appRoot.querySelector('[data-reorder-type="' + currentType + '"][data-reorder-index="' + toIndex + '"]');
            if (moved) moved.focus();
          });
        }
      });
    }

    document.addEventListener('pointermove', function(event) {
      if (!charmDrag || event.pointerId !== charmDrag.pointerId) return;
      var distance = Math.hypot(event.clientX - charmDrag.startX, event.clientY - charmDrag.startY);
      if (!charmDrag.started && distance >= 6) {
        charmDrag.started = true;
        charmDrag.source.classList.add('is-drag-source');
        charmDrag.ghost = charmDrag.source.cloneNode(true);
        charmDrag.ghost.removeAttribute('id');
        charmDrag.ghost.removeAttribute('tabindex');
        charmDrag.ghost.removeAttribute('data-charm-reorder');
        charmDrag.ghost.classList.remove('is-drag-source');
        charmDrag.ghost.classList.add('charm-drag-ghost');
        charmDrag.ghost.setAttribute('aria-hidden', 'true');
        document.body.appendChild(charmDrag.ghost);
        document.body.classList.add('is-reordering-charm');
      }
      if (!charmDrag.started) return;
      event.preventDefault();
      positionCharmGhost(event.clientX, event.clientY);
      clearCharmDropTargets();
      var target = closestCharmDropTarget(charmDrag.type, event.clientX, event.clientY);
      if (target) target.classList.add('is-drop-target');
    }, { passive: false });

    document.addEventListener('pointerup', function(event) { finishCharmDrag(event, false); });
    document.addEventListener('pointercancel', function(event) { finishCharmDrag(event, true); });

    // 1. Mode Switcher
    var typeBtns = document.querySelectorAll('.type-switch-row .type-btn');
    typeBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        typeBtns.forEach(function(b) { b.classList.remove('active'); });
