        var chosen = btn.getAttribute('data-type');
        state.modelType = chosen;

        // Hide all stages first
        stagePhoneCharm.style.display = 'none';
        stageBagClipMulti.style.display = 'none';
        stageBagClipSingle.style.display = 'none';

        if (chosen === 'bag-clip-multi') {
          stageBagClipMulti.style.display = 'block';
          if (bagClipTargetSection) bagClipTargetSection.style.display = 'none';
          if (tabBtnName) tabBtnName.style.display = '';
          if (tabBtnClasp) tabBtnClasp.textContent = '1. Clasp Finish';
          if (tabBtnPalette) tabBtnPalette.textContent = '3. Color Story';
          if (tabBtnCharms) tabBtnCharms.textContent = '4. Charms';

          if (claspHeadingLabel) claspHeadingLabel.textContent = 'Select Clasp Hardware Finish';
          if (claspDescText) claspDescText.textContent = 'Choose the luxury metal swivel clasp & ring for your handbag charm.';
          if (claspSelectorPhone) claspSelectorPhone.style.display = 'none';
          if (claspSelectorBagSingle) claspSelectorBagSingle.style.display = 'none';
          if (claspSelectorBagMulti) claspSelectorBagMulti.style.display = 'grid';

          var activeMultiCard = document.querySelector('#claspSelectorBagMulti .option-card.active');
          if (activeMultiCard) applySelectedClasp(activeMultiCard);

          var chHeading = document.getElementById('charmsListHeading');
          if (chHeading) chHeading.textContent = 'Select Atelier Charms';
          var chDesc = document.getElementById('charmsListDesc');
          if (chDesc) chDesc.textContent = 'Tap charms below to auto-attach (up to 4). Drag charms on the preview above to swap strings.';
          var chBadge = document.getElementById('charmsLimitBadge');
          if (chBadge) chBadge.textContent = 'Max 4 Charms';

        } else if (chosen === 'bag-clip-single') {
          stageBagClipSingle.style.display = 'block';
          bagClipTargetSection.style.display = 'none';
          if (tabBtnClasp) tabBtnClasp.textContent = '1. Cord & Clasp';
          if (tabBtnPalette) tabBtnPalette.textContent = '2. Color Story';
          if (tabBtnCharms) tabBtnCharms.textContent = '3. Charms';
          
          // Hide custom name tab for Single Cord style
          if (tabBtnName) tabBtnName.style.display = 'none';
          
          // If on Name tab, switch automatically to Charms tab
          if (tabBtnName && tabBtnName.classList.contains('active')) {
            tabBtns.forEach(function(b) { b.classList.remove('active'); });
            tabPanes.forEach(function(p) { p.classList.remove('active'); });
            var charmsTabBtn = document.querySelector('.controls-nav-tabs .tab-btn[data-tab="tab-charms"]');
            if (charmsTabBtn) charmsTabBtn.classList.add('active');
            var charmsPane = document.getElementById('tab-charms');
            if (charmsPane) charmsPane.classList.add('active');
          }

          if (claspHeadingLabel) claspHeadingLabel.textContent = 'Select Cord Color & Clasp';
          if (claspDescText) claspDescText.textContent = 'Choose the central jewelry cord color and clasp for your attached charms.';
          if (claspSelectorPhone) claspSelectorPhone.style.display = 'none';
          if (claspSelectorBagMulti) claspSelectorBagMulti.style.display = 'none';
          if (claspSelectorBagSingle) claspSelectorBagSingle.style.display = 'grid';

          var activeSingleCard = document.querySelector('#claspSelectorBagSingle .option-card.active');
          if (activeSingleCard) applySelectedClasp(activeSingleCard);

          document.getElementById('charmsListHeading').textContent = 'Select Atelier Charms to Attach';
          document.getElementById('charmsListDesc').textContent = 'Tap any charm below to attach it along your cord (up to 7). Tap on attached charm to remove.';
          document.getElementById('charmsLimitBadge').textContent = 'Max 7 Charms';

        } else {
          stagePhoneCharm.style.display = 'block';
          bagClipTargetSection.style.display = 'none';
          if (tabBtnName) tabBtnName.style.display = '';
          if (tabBtnClasp) tabBtnClasp.textContent = '1. Tether Cord';
          if (tabBtnPalette) tabBtnPalette.textContent = '3. Color Story';
          if (tabBtnCharms) tabBtnCharms.textContent = '4. Charms';

          if (claspHeadingLabel) claspHeadingLabel.textContent = 'Select Tether Cord Color';
          if (claspDescText) claspDescText.textContent = 'Choose your soft durable nylon cord that loops through your phone case.';
          if (claspSelectorBagMulti) claspSelectorBagMulti.style.display = 'none';
          if (claspSelectorBagSingle) claspSelectorBagSingle.style.display = 'none';
