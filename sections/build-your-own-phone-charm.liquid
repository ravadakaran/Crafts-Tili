  /* Exact V-Formation with Reduced Space Between Strand 2 & 3 */
  /* Strand 1: Far Left, angles down toward Bell drop, dynamically colored with clasp finish */
  .strand-1-accent {
    left: calc(50% - 78px);
    top: 14px;
    transform-origin: top center;
    transform: rotate(10deg);
    z-index: 4;
  }
  /* Strand 2: Center-Left, reduced space with Strand 3 (36px total gap) */
  .strand-2-name {
    left: calc(50% - 18px);
    top: 14px;
    transform: translateX(-50%);
    z-index: 5;
  }
  /* Strand 3: Center-Right, reduced space with Strand 2 */
  .strand-3-statement {
    left: calc(50% + 18px);
    top: 14px;
    transform: translateX(-50%) rotate(-3deg);
    z-index: 3;
  }
  /* Strand 4: Far Right, closer to Strand 3 with reduced gap */
  .strand-4-dangle {
