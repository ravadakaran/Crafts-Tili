        </div>
      </div>

      <!-- Item 3 -->
      <div class="gallery-item item-3">
        <div class="gallery-media-placeholder p-gradient-3">
          <span class="gallery-emoji-large">🌈</span>
          <span class="gallery-vibe-tag">Golden Hour Prisms</span>
        </div>
        <div class="gallery-hover-overlay">
          <span class="insta-glyph">📸</span>
          <strong>@sunshine_spaces</strong>
          <span>K9 Crystal Suncatcher</span>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="gallery-item item-4">
        <div class="gallery-media-placeholder p-gradient-4">
          <span class="gallery-emoji-large">✨</span>
          <span class="gallery-vibe-tag">Bestie Matching Set</span>
        </div>
        <div class="gallery-hover-overlay">
          <span class="insta-glyph">📸</span>
          <strong>@ria_and_tara</strong>
          <span>Initial Bead Charms</span>
        </div>
      </div>

      <!-- Item 5 -->
      <div class="gallery-item item-5">
        <div class="gallery-media-placeholder p-gradient-5">
          <span class="gallery-emoji-large">🔑</span>
          <span class="gallery-vibe-tag">Pastel Keychain Clip</span>
        </div>
        <div class="gallery-hover-overlay">
          <span class="insta-glyph">📸</span>
          <strong>@cozy_vibes_only</strong>
          <span>Celestial Star Dangle</span>
        </div>
      </div>

      <!-- Item 6 -->
      <div class="gallery-item item-6">
        <div class="gallery-media-placeholder p-gradient-6">
          <span class="gallery-emoji-large">📖</span>
          <span class="gallery-vibe-tag">Reading Cozy Aesthetic</span>
        </div>
        <div class="gallery-hover-overlay">
          <span class="insta-glyph">📸</span>
          <strong>@bookworm_diaries</strong>
          <span>Handmade Bookmark Dangle</span>
        </div>
      </div>
    </div>

    <!-- Instagram Follow Callout -->
    <div class="gallery-footer-cta">
      <a href="https://instagram.com/crafts_titli" target="_blank" rel="noopener" class="gallery-insta-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        <span>Follow @crafts_titli on Instagram 🦋</span>
      </a>
    </div>

  </div>
</section>

<style>
.titli-gallery-section {
  padding: 60px 20px;
  background: transparent;
}

.gallery-container {
  max-width: 1240px;
  margin: 0 auto;
}

.gallery-header {
  text-align: center;
  max-width: 600px;
  margin: 0 auto 36px auto;
}

.gallery-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #607353;
  margin-bottom: 8px;
}

.gallery-title {
  margin: 0 0 10px 0;
  font-family: var(--font-heading, 'Quicksand', sans-serif);
  font-size: 32px;
  font-weight: 700;
  color: #712423;
  letter-spacing: -0.5px;
}

.gallery-subtext {
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 14.5px;
  color: #554D48;
  margin: 0;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16px;
}

.gallery-item {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  aspect-ratio: 1;
  box-shadow: 0 4px 16px rgba(113, 36, 35, 0.05);
  cursor: pointer;
  border: 1px solid rgba(231, 219, 202, 0.7);
  transition: transform 0.35s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.35s ease;
}

.gallery-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(113, 36, 35, 0.12);
}

.gallery-media-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  box-sizing: border-box;
}

.p-gradient-1 { background: linear-gradient(135deg, #FDE8E9 0%, #F6D6D7 100%); }
.p-gradient-2 { background: linear-gradient(135deg, #FFF0DE 0%, #FBE5CE 100%); }
.p-gradient-3 { background: linear-gradient(135deg, #F0F6EA 0%, #DFECDA 100%); }
.p-gradient-4 { background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%); }
.p-gradient-5 { background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%); }
.p-gradient-6 { background: linear-gradient(135deg, #FCE7F3 0%, #FBCFE8 100%); }

.gallery-emoji-large {
  font-size: 36px;
  filter: drop-shadow(0 2px 4px rgba(0,0,0,0.08));
}

.gallery-vibe-tag {
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 11px;
  font-weight: 700;
  color: #712423;
  text-align: center;
}

.gallery-hover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(113, 36, 35, 0.88);
  backdrop-filter: blur(4px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: #FAF5EE;
  padding: 14px;
  box-sizing: border-box;
  text-align: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.gallery-item:hover .gallery-hover-overlay,
.gallery-item:active .gallery-hover-overlay {
  opacity: 1;
}

.insta-glyph {
  font-size: 20px;
  margin-bottom: 2px;
}

.gallery-hover-overlay strong {
  font-size: 12.5px;
  letter-spacing: 0.3px;
}

.gallery-hover-overlay span {
  font-size: 11px;
  color: #E7DBCA;
}

.gallery-footer-cta {
  text-align: center;
  margin-top: 36px;
}

.gallery-insta-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #ffffff;
  color: #712423;
  border: 1.5px solid #712423;
  text-decoration: none;
  padding: 12px 26px;
  border-radius: 30px;
  font-family: var(--font-body, 'Quicksand', sans-serif);
  font-size: 13.5px;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(113, 36, 35, 0.06);
  transition: all 0.25s ease;
}

.gallery-insta-btn:hover {
  background: #712423;
  color: #FAF5EE;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(113, 36, 35, 0.15);
}

@media (max-width: 1024px) {
  .gallery-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
}

@media (max-width: 600px) {
  .titli-gallery-section {
    padding: 30px 14px;
  }
  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  .gallery-title {
    font-size: 24px;
  }
  .gallery-emoji-large {
    font-size: 28px;
  }
  .gallery-insta-btn {
    width: 100%;
    justify-content: center;
    box-sizing: border-box;
    padding: 14px 20px;
  }
}
</style>

{% schema %}
{
  "name": "Community Gallery",
  "settings": [],
  "presets": [
    {
      "name": "Community Gallery"
    }
  ]
}
{% endschema %}
