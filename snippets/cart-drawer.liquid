/* Footer & Checkout */
.titli-drawer-footer {
  padding: 18px 24px 22px;
  background: #FFFFFF;
  border-top: 1px solid rgba(231, 219, 202, 0.75);
  box-shadow: 0 -4px 16px rgba(113, 36, 35, 0.04);
}

.drawer-subtotal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.subtotal-label {
  font-family: 'Quicksand', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #2B1B17;
}

.subtotal-value {
  font-family: 'Quicksand', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: #712423;
}

.drawer-shipping-note {
  font-size: 11px;
  color: #8C7B75;
  margin: 0 0 14px 0;
}

.drawer-action-btns {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.drawer-checkout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #712423 0%, #8D302F 100%);
  color: #FFFFFF;
  font-family: 'Quicksand', sans-serif;
  font-size: 14.5px;
  font-weight: 700;
  text-decoration: none;
  padding: 13px;
  border-radius: 30px;
  box-shadow: 0 4px 14px rgba(113, 36, 35, 0.25);
  transition: transform 0.2s, box-shadow 0.2s;
}

.drawer-checkout-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(113, 36, 35, 0.35);
}

.drawer-view-bag-link {
  text-align: center;
  font-size: 12px;
  color: #712423;
  text-decoration: underline;
  font-weight: 600;
  padding: 4px;
}

.drawer-view-bag-link:hover {
  color: #B32025;
}

.drawer-trust-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
  font-size: 10.5px;
  color: #8C7B75;
  font-weight: 600;
}
</style>

<script>
window.TitliDrawer = (function() {
  const FREE_SHIPPING_THRESHOLD_PENCE = 150000; // ₹1500 in paise

  function formatMoney(cents) {
    if (typeof cents !== 'number') cents = parseInt(cents, 10) || 0;
    const rupees = (cents / 100).toFixed(2);
    // Format without trailing decimals if whole number
    return '₹' + rupees.replace(/\.00$/, '');
  }

  function getDrawer() {
    return document.getElementById('titli-cart-drawer');
  }

  function openDrawer() {
    const drawer = getDrawer();
    if (drawer) {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      refreshDrawer();
    }
  }

  function closeDrawer() {
    const drawer = getDrawer();
    if (drawer) {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  function showLoading(show) {
    const loader = document.getElementById('titli-drawer-loader');
    if (loader) loader.style.display = show ? 'flex' : 'none';
  }

  // Fetch current cart JSON and render
  async function refreshDrawer() {
    showLoading(true);
    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();
      renderCart(cart);
    } catch (err) {
      console.error('Failed to load cart', err);
    } finally {
      showLoading(false);
    }
  }

  function updateHeaderBadge(count) {
    const headerBadges = document.querySelectorAll('.header-cart-badge');
    headerBadges.forEach(badge => {
      badge.textContent = count;
      badge.style.display = count > 0 ? 'inline-block' : 'none';
    });
    const drawerCount = document.getElementById('titli-drawer-count');
    if (drawerCount) drawerCount.textContent = `(${count})`;
  }

  function renderCart(cart) {
    const container = document.getElementById('titli-drawer-items-container');
    const emptyState = document.getElementById('titli-drawer-empty');
    const footer = document.getElementById('titli-drawer-footer');
    const subtotalEl = document.getElementById('titli-drawer-subtotal');
    const shippingMsg = document.getElementById('titli-shipping-msg');
    const shippingFill = document.getElementById('titli-shipping-fill');

    if (!container) return;

    // Filter out internal child items for display count
    let visibleCount = 0;
    const parentItems = [];

    // Map items
    cart.items.forEach(item => {
      if (!item.properties || item.properties._bundle_child !== 'true') {
        visibleCount += item.quantity;
        parentItems.push(item);
      }
    });

    updateHeaderBadge(visibleCount);

    // Free shipping progress logic
    const remaining = FREE_SHIPPING_THRESHOLD_PENCE - cart.total_price;
    if (remaining <= 0) {
      shippingMsg.innerHTML = '🎉 <strong>Congratulations!</strong> You have unlocked <strong>FREE Shipping</strong>!';
      shippingFill.style.width = '100%';
    } else {
      const pct = Math.min(100, Math.max(8, (cart.total_price / FREE_SHIPPING_THRESHOLD_PENCE) * 100));
      shippingMsg.innerHTML = `Add <strong>${formatMoney(remaining)}</strong> more to get <strong>FREE SHIPPING!</strong>`;
      shippingFill.style.width = `${pct}%`;
    }

    // Toggle Empty vs Filled
    if (parentItems.length === 0) {
      container.innerHTML = '';
      emptyState.style.display = 'block';
      footer.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    footer.style.display = 'block';
    subtotalEl.textContent = formatMoney(cart.total_price);

    // Render items
    let html = '';
    parentItems.forEach(item => {
      const isBundle = item.properties && item.properties._bundle_id;
      const isCustomizer = isBundle || (item.properties && item.properties._customizer === 'true');
      const imgUrl = item.image || item.featured_image ? (item.image || item.featured_image) : '';
      const thumb = imgUrl ? `<img src="${imgUrl}" alt="${item.title}" class="drawer-item-thumb">` : `<div class="drawer-item-thumb" style="display:flex;align-items:center;justify-content:center;font-size:20px;">✨</div>`;
      
      const variantHtml = item.variant_title && item.variant_title !== 'Default Title' 
        ? `<div class="drawer-item-variant">${item.variant_title}</div>` : '';

      const badgeHtml = isCustomizer ? `<span class="drawer-item-badge">✨ Custom Atelier Piece</span>` : '';

      html += `
        <div class="drawer-item-card" data-key="${item.key}">
          ${thumb}
          <div class="drawer-item-meta">
            <div class="drawer-item-top">
              <div>
                <a href="${item.url}" class="drawer-item-title">${item.product_title}</a>
                ${badgeHtml}
                ${variantHtml}
              </div>
              <button type="button" class="drawer-item-remove-btn" onclick="window.TitliDrawer.removeItem('${item.key}')" title="Remove">✕</button>
            </div>
            
            <div class="drawer-item-bottom">
              <div class="drawer-qty-stepper">
                <button type="button" class="drawer-qty-btn" onclick="window.TitliDrawer.updateQty('${item.key}', ${item.quantity - 1})">−</button>
                <span class="drawer-qty-val">${item.quantity}</span>
                <button type="button" class="drawer-qty-btn" onclick="window.TitliDrawer.updateQty('${item.key}', ${item.quantity + 1})">+</button>
              </div>
              <span class="drawer-item-price">${(() => {
                let lineTotal = item.final_line_price;
                if (isBundle) {
                  const bId = item.properties._bundle_id;
                  cart.items.forEach(c => {
                    if (c.properties && c.properties._bundle_id === bId && c.properties._bundle_child === 'true') {
                      lineTotal += c.final_line_price;
                    }
                  });
                }
                return formatMoney(lineTotal);
              })()}</span>
            </div>
          </div>
        </div>
      `;
    });

    container.innerHTML = html;
  }

  // Update item quantity
  async function updateQty(key, newQty) {
    showLoading(true);
    try {
      const res = await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: newQty })
      });
      const updatedCart = await res.json();
      renderCart(updatedCart);
    } catch (err) {
      console.error('Failed to update quantity', err);
    } finally {
      showLoading(false);
    }
  }

  // Remove item
  async function removeItem(key) {
    return updateQty(key, 0);
  }

  // Add item via Ajax (from product page or upsell button)
  async function addItem(variantId, quantity = 1, properties = {}) {
    showLoading(true);
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: variantId,
          quantity: quantity,
          properties: properties
        })
      });
      if (res.ok) {
        openDrawer();
      } else {
        const error = await res.json();
        alert(error.description || 'Could not add item to bag.');
      }
    } catch (err) {
      console.error('Add to cart failed', err);
    } finally {
      showLoading(false);
    }
  }

  // Init event bindings
  function init() {
    // Backdrop click
    const backdrop = document.getElementById('titli-drawer-backdrop-btn');
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    // Close button click
    const closeBtn = document.getElementById('titli-drawer-close-btn');
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

    // Intercept Header Cart Icon Click
    document.querySelectorAll('.header-cart-wrap').forEach(link => {
      link.addEventListener('click', function(e) {
        // Prevent default navigation to /cart and open drawer instead
        e.preventDefault();
        openDrawer();
      });
    });

    // Intercept Quick-Add forms across the site (e.g. Featured Products)
    document.addEventListener('submit', function(e) {
      const form = e.target;
      if (form.matches('.quick-add-form, #titliProductForm')) {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        const formData = new FormData(form);
        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(res => res.json())
        .then(data => {
          if (data.status && data.status !== 200) {
            alert(data.description || 'Could not add to bag');
          } else {
            openDrawer();
          }
        })
        .catch(err => console.error(err))
        .finally(() => {
          if (submitBtn) submitBtn.disabled = false;
        });
      }
    });

    // In-Drawer Upsell Quick Add Buttons
    document.addEventListener('click', function(e) {
      const upsellBtn = e.target.closest('.drawer-quick-add-upsell-btn');
      if (upsellBtn) {
        const variantId = upsellBtn.getAttribute('data-variant-id');
        if (variantId) {
          upsellBtn.textContent = 'Adding...';
          addItem(variantId, 1).then(() => {
            upsellBtn.textContent = '✓ Added';
            setTimeout(() => { upsellBtn.textContent = '+ Add'; }, 2000);
          });
        }
      }
    });

    // ESC key closes drawer
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDrawer();
    });
  }

  document.addEventListener('DOMContentLoaded', init);

  return {
    open: openDrawer,
    close: closeDrawer,
    refresh: refreshDrawer,
    addItem: addItem,
    updateQty: updateQty,
    removeItem: removeItem
  };
})();
</script>
